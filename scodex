#!/usr/bin/env bash
# scodex: Run Codex CLI in a Docker sandbox
# Supported shells: bash, zsh (via #!/usr/bin/env bash shebang)
# Supported platforms: macOS (Darwin), Linux

set -euo pipefail

SCRIPT_NAME="scodex"
TOOL_NAME="Codex"
TOOL_BIN="codex"
CONFIG_VOLUME="scodex-config"
CONFIG_MOUNT="/scodex-config"
CONFIG_ENV_NAME="CODEX_HOME"
YOLO_FLAG="--dangerously-bypass-approvals-and-sandbox"
WRAPPER_VERSION="2.15.0" # x-release-please-version
PROJECT_REPO="e6qu/sclaude"
RELEASE_CHECK_INTERVAL_SECONDS="86400"
ENGINE_CMD=""
ENGINE_TIMEOUT_SECONDS="${SAGENT_ENGINE_TIMEOUT_SECONDS:-10}"

IMAGE_REPO="sagent-sandbox"
MEMORY_LIMIT="4g"
CPU_LIMIT="2"
PIDS_LIMIT="100"
PIDS_LIMIT_NESTED="512"

# Toolchain versions baked into the image (all part of the image hash).
# Defaults track the latest releases at the time of this wrapper's release.
# Go/Rust/Java accept "none" to leave that toolchain out of the image.
UBUNTU_VERSION="26.04"
NODE_VERSION="26"
PYTHON_VERSION="3.14"
GO_VERSION="1.27"
RUST_VERSION="stable"
JAVA_VERSION="26"

ROOTFS_VOLUME="sagent-rootfs"
NPM_VOLUME="sagent-npm"
PIP_VOLUME="sagent-pip"
APT_CACHE_VOLUME="sagent-apt-cache"
APT_LISTS_VOLUME="sagent-apt-lists"
CONTAINERS_VOLUME="sagent-containers"
# XDG data: what `uv tool install` installs, the Pythons uv manages, and
# anything else a tool keeps in ~/.local/share. Its own volume because the
# pip volume around it is cleared on a Python change, and none of this
# belongs to the image's Python.
SHARE_VOLUME="sagent-share"

HOST_UID=$(id -u)
HOST_GID=$(id -g)

# Optional config file: plain bash sourced at startup. May set the tunables
# above (MEMORY_LIMIT, CPU_LIMIT, PIDS_LIMIT, PIDS_LIMIT_NESTED,
# ENGINE_TIMEOUT_SECONDS) and defaults for the SAGENT_* settings below.
# Environment variables and command-line flags take precedence over the file.
# Arrays, not space-separated strings: zsh (T14) does not word-split unquoted
# variables, so `for x in $list` would see one item.
SAGENT_SETTINGS=(SAGENT_DOCKER SAGENT_CONTAINER_ENGINE SAGENT_CA_BUNDLE SAGENT_CLIPBOARD SAGENT_GIT_PROTOCOL SAGENT_UBUNTU_VERSION SAGENT_NODE_VERSION SAGENT_PYTHON_VERSION SAGENT_GO_VERSION SAGENT_RUST_VERSION SAGENT_JAVA_VERSION SAGENT_TOOLS)
# Tunables the config file may also set (not SAGENT_-prefixed, no env override).
SAGENT_TUNABLES=(MEMORY_LIMIT CPU_LIMIT PIDS_LIMIT PIDS_LIMIT_NESTED)
SAGENT_CONFIG_FILE="${SAGENT_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sagent/config}"
if [ -f "$SAGENT_CONFIG_FILE" ]; then
    # Validate before sourcing: a syntax error mid-source would abort the
    # wrapper with a message that never names the config file.
    if ! bash -n "$SAGENT_CONFIG_FILE" 2>/dev/null; then
        echo "[$SCRIPT_NAME] ERROR: config file has a syntax error: $SAGENT_CONFIG_FILE" >&2
        exit 1
    fi
    # Remember which settings the environment set so they win over the file.
    for _name in "${SAGENT_SETTINGS[@]}"; do
        eval "_env_${_name}=\${${_name}:-}"
    done
    # shellcheck disable=SC1090
    . "$SAGENT_CONFIG_FILE"
    for _name in "${SAGENT_SETTINGS[@]}"; do
        eval "_value=\${_env_${_name}}"
        if [ -n "$_value" ]; then
            eval "${_name}=\$_value"
            eval "SAGENT_SOURCE_${_name}=env"
        else
            eval "_value=\${${_name}:-}"
            if [ -n "$_value" ]; then eval "SAGENT_SOURCE_${_name}=config"; fi
        fi
        unset "_env_${_name}"
    done
    unset _name _value
else
    for _name in "${SAGENT_SETTINGS[@]}"; do
        eval "_value=\${${_name}:-}"
        if [ -n "$_value" ]; then eval "SAGENT_SOURCE_${_name}=env"; fi
    done
    unset _name _value
fi

# Toolchain version settings, validated so a typo fails here instead of deep
# inside a 20-minute image build.
UBUNTU_VERSION="${SAGENT_UBUNTU_VERSION:-$UBUNTU_VERSION}"
NODE_VERSION="${SAGENT_NODE_VERSION:-$NODE_VERSION}"
PYTHON_VERSION="${SAGENT_PYTHON_VERSION:-$PYTHON_VERSION}"
GO_VERSION="${SAGENT_GO_VERSION:-$GO_VERSION}"
RUST_VERSION="${SAGENT_RUST_VERSION:-$RUST_VERSION}"
JAVA_VERSION="${SAGENT_JAVA_VERSION:-$JAVA_VERSION}"
validate_version_setting() {
    local name="$1" value="$2" pattern="$3" hint="$4"
    if ! printf '%s' "$value" | grep -qE "$pattern"; then
        echo "[$SCRIPT_NAME] ERROR: $name=\"$value\" is not valid; expected $hint" >&2
        exit 1
    fi
}
validate_version_setting SAGENT_UBUNTU_VERSION "$UBUNTU_VERSION" '^[0-9]{2}\.[0-9]{2}$' 'a release like 26.04'
validate_version_setting SAGENT_NODE_VERSION "$NODE_VERSION" '^[0-9]+$' 'a major version like 26'
validate_version_setting SAGENT_PYTHON_VERSION "$PYTHON_VERSION" '^3\.[0-9]+$' 'a minor version like 3.14'
validate_version_setting SAGENT_GO_VERSION "$GO_VERSION" '^(none|1\.[0-9]+(\.[0-9]+)?)$' '1.27, 1.27.1, or none'
validate_version_setting SAGENT_RUST_VERSION "$RUST_VERSION" '^(none|stable|beta|nightly|[0-9]+\.[0-9]+(\.[0-9]+)?)$' 'stable, beta, nightly, 1.98.0, or none'
validate_version_setting SAGENT_JAVA_VERSION "$JAVA_VERSION" '^(none|[0-9]+)$' 'a major version like 26, or none'
# How git and gh reach GitHub from inside the sandbox: ssh (the host's ~/.ssh
# is synced in) or https (gh's token serves git, SSH remotes are rewritten).
# Unset means the protocol the host's gh is configured with.
if [ -n "${SAGENT_GIT_PROTOCOL:-}" ]; then
    validate_version_setting SAGENT_GIT_PROTOCOL "$SAGENT_GIT_PROTOCOL" '^(ssh|https)$' 'ssh or https'
fi
# SAGENT_CLIPBOARD=0 keeps the host clipboard out of the sandbox (no bridge).
if [ -n "${SAGENT_CLIPBOARD:-}" ]; then
    validate_version_setting SAGENT_CLIPBOARD "$SAGENT_CLIPBOARD" '^[01]$' '0 or 1'
fi

# Optional tooling baked into the image, all at their latest release as of
# the build. SAGENT_TOOLS selects by name or group (comma/space separated):
# "all" (default), "none", "js", "java", or explicit names. Java tools need a
# JDK: with SAGENT_JAVA_VERSION=none they drop out of "all"/"java" silently
# but naming one explicitly is an error. Registry rows: name|group|description.
SAGENT_TOOL_REGISTRY='typescript|js|TypeScript compiler (tsc)
tsx|js|run TypeScript files directly
bun|js|Bun runtime and package manager
corepack|js|yarn and pnpm at the version a project declares
create-next-app|js|Next.js project scaffolding
create-vite|js|Vite project scaffolding (React, Vue, Svelte, ...)
shadcn|js|shadcn/ui component CLI
maven|java|Apache Maven
gradle|java|Gradle
quarkus|java|Quarkus CLI
spring|java|Spring Boot CLI'
SAGENT_TOOLS="${SAGENT_TOOLS:-all}"

tool_group() { printf '%s\n' "$SAGENT_TOOL_REGISTRY" | awk -F'|' -v n="$1" '$1 == n {print $2}'; }
tool_known() { [ -n "$(tool_group "$1")" ]; }

# Resolve $1 (a SAGENT_TOOLS value) into TOOLS_SELECTED: registry order,
# deduplicated, Java tools only with a JDK. Exits with a message on unknown
# names or on a Java tool named explicitly without a JDK.
resolve_tools() {
    local spec="$1" item name group wanted="" explicit_java=""
    while read -r item; do
        [ -n "$item" ] || continue
        case "$item" in
            all) wanted="$wanted js java" ;;
            none) ;;
            js | java) wanted="$wanted $item" ;;
            *)
                if ! tool_known "$item"; then
                    echo "[$SCRIPT_NAME] ERROR: SAGENT_TOOLS names an unknown tool: $item" >&2
                    echo "[$SCRIPT_NAME] Known: $(printf '%s\n' "$SAGENT_TOOL_REGISTRY" | cut -d'|' -f1 | tr '\n' ' ')and the groups all, none, js, java" >&2
                    exit 1
                fi
                wanted="$wanted $item"
                if [ "$(tool_group "$item")" = java ]; then explicit_java="$explicit_java $item"; fi
                ;;
        esac
    done <<< "$(printf '%s' "$spec" | tr ', ' '\n')"
    if [ -n "$explicit_java" ] && [ "$JAVA_VERSION" = none ]; then
        echo "[$SCRIPT_NAME] ERROR: SAGENT_TOOLS names Java tools (${explicit_java# }) but SAGENT_JAVA_VERSION=none; they need a JDK." >&2
        exit 1
    fi
    TOOLS_SELECTED=""
    while IFS='|' read -r name group _; do
        case " $wanted " in
            *" $name "* | *" $group "*)
                if [ "$group" = java ] && [ "$JAVA_VERSION" = none ]; then continue; fi
                TOOLS_SELECTED="$TOOLS_SELECTED $name"
                ;;
        esac
    done <<EOF
$SAGENT_TOOL_REGISTRY
EOF
    TOOLS_SELECTED="${TOOLS_SELECTED# }"
}
resolve_tools "$SAGENT_TOOLS"
tool_selected() { case " $TOOLS_SELECTED " in *" $1 "*) return 0 ;; esac; return 1; }

# Extra trust anchors for the sandbox image. Corporate networks often run a
# TLS-inspecting proxy whose CA the host trusts (macOS keychain, Linux system
# store) but a fresh Ubuntu image does not: Docker Desktop and Rancher Desktop
# trust the host's CAs for image pulls, yet every `RUN curl`/`npm install` in
# the build and every HTTPS request from inside the sandbox fails with
# "unable to get local issuer certificate". SAGENT_CA_BUNDLE names a PEM file
# (one or more certificates) that gets baked into the image's trust store.
CA_BUNDLE_PATH="${SAGENT_CA_BUNDLE:-}"
CA_BUNDLE_CERT_COUNT=0
if [ -n "$CA_BUNDLE_PATH" ]; then
    if [ ! -f "$CA_BUNDLE_PATH" ] || [ ! -r "$CA_BUNDLE_PATH" ]; then
        echo "[$SCRIPT_NAME] ERROR: SAGENT_CA_BUNDLE is not a readable file: $CA_BUNDLE_PATH" >&2
        exit 1
    fi
    CA_BUNDLE_CERT_COUNT=$(grep -c -- '-----BEGIN CERTIFICATE-----' "$CA_BUNDLE_PATH" || true)
    if [ "$CA_BUNDLE_CERT_COUNT" -eq 0 ]; then
        echo "[$SCRIPT_NAME] ERROR: SAGENT_CA_BUNDLE contains no PEM certificates (no '-----BEGIN CERTIFICATE-----' block): $CA_BUNDLE_PATH" >&2
        exit 1
    fi
fi

TEMP_FILES=()
cleanup_temp() {
    if [ -n "${CLIPBOARD_BRIDGE_PID:-}" ]; then
        kill "$CLIPBOARD_BRIDGE_PID" 2>/dev/null || true
    fi
    for f in "${TEMP_FILES[@]+"${TEMP_FILES[@]}"}"; do
        rm -rf "$f"
    done
}
trap cleanup_temp EXIT INT TERM HUP

portable_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256
    else
        echo "ERROR: neither sha256sum nor shasum found" >&2
        exit 1
    fi
}

run_with_timeout_quiet() {
    local seconds="$1"; shift
    local cmd_pid
    local timer_pid
    local rc

    "$@" >/dev/null 2>&1 &
    cmd_pid=$!
    (
        sleep "$seconds"
        kill "$cmd_pid" 2>/dev/null || true
    ) &
    timer_pid=$!

    if wait "$cmd_pid"; then
        rc=0
    else
        rc=$?
    fi
    kill "$timer_pid" 2>/dev/null || true
    wait "$timer_pid" 2>/dev/null || true
    return "$rc"
}

select_engine() {
    local requested="${SAGENT_CONTAINER_ENGINE:-}"
    local candidate

    if [ -n "$requested" ]; then
        if ! command -v "$requested" >/dev/null 2>&1; then
            echo "[$SCRIPT_NAME] ERROR: requested container engine not found: $requested" >&2
            return 1
        fi
        if ! run_with_timeout_quiet "$ENGINE_TIMEOUT_SECONDS" "$requested" info; then
            echo "[$SCRIPT_NAME] ERROR: requested container engine is not responding: $requested" >&2
            return 1
        fi
        ENGINE_CMD="$requested"
        return 0
    fi

    for candidate in docker podman; do
        if command -v "$candidate" >/dev/null 2>&1 && run_with_timeout_quiet "$ENGINE_TIMEOUT_SECONDS" "$candidate" info; then
            ENGINE_CMD="$candidate"
            return 0
        fi
    done

    # Name the likely cause from what is actually on PATH instead of a generic
    # "no engine" message.
    if command -v docker >/dev/null 2>&1 || command -v podman >/dev/null 2>&1; then
        echo "[$SCRIPT_NAME] ERROR: a container engine CLI is installed but no daemon answered within ${ENGINE_TIMEOUT_SECONDS}s (tried: docker, podman)." >&2
        echo "[$SCRIPT_NAME] Start Docker Desktop, Rancher Desktop, colima, or the podman machine, then retry. SAGENT_ENGINE_TIMEOUT_SECONDS raises the probe timeout." >&2
    elif command -v rdctl >/dev/null 2>&1 || command -v nerdctl >/dev/null 2>&1; then
        echo "[$SCRIPT_NAME] ERROR: Rancher Desktop is installed but no docker CLI is available." >&2
        echo "[$SCRIPT_NAME] The wrappers need the dockerd (moby) engine: Rancher Desktop > Preferences > Container Engine > dockerd (moby), and ~/.rd/bin on PATH. The containerd engine (nerdctl) is not supported." >&2
    else
        echo "[$SCRIPT_NAME] ERROR: neither docker nor podman is available and responding." >&2
    fi
    echo "[$SCRIPT_NAME] Set SAGENT_CONTAINER_ENGINE=docker or SAGENT_CONTAINER_ENGINE=podman to choose explicitly." >&2
    return 1
}

# The command name does not identify the engine: a `docker` command can be
# podman's CLI shim (podman-docker), and a real docker CLI can talk to a podman
# server through the docker-compat socket (DOCKER_HOST). Build/export semantics
# depend on the actual CLI and server, so identify both once.
detect_engine_flavor() {
    local version_output client_section server_section

    # `--version` is useless here: podman invoked as `docker` emulates docker's
    # one-line version string. The plain `version` output is honest on both
    # sides — "Podman Engine" appears in the Client section for the podman CLI
    # (under any command name) and in the Server section when the socket is
    # served by podman (via docker's compat components or podman's own output).
    version_output=$("$ENGINE_CMD" version 2>/dev/null || true)
    client_section=$(printf '%s\n' "$version_output" | sed -n '1,/^Server/p')
    server_section=$(printf '%s\n' "$version_output" | sed -n '/^Server/,$p')

    ENGINE_CLI_FLAVOR="docker"
    ENGINE_SERVER_FLAVOR="docker"
    case "$client_section" in
        *[Pp]odman*) ENGINE_CLI_FLAVOR="podman" ;;
    esac
    case "$server_section" in
        *[Pp]odman*) ENGINE_SERVER_FLAVOR="podman" ;;
    esac

    # A rootless daemon maps the container's non-root UIDs to subordinate
    # UIDs, so the sandbox user (the host UID inside the image) is a stranger
    # to the workspace bind mount: unreadable when 0700, read-only otherwise
    # (#75). Podman's --userns=keep-id maps the invoking user onto that UID;
    # the docker CLI has no way to request it, so that combination is refused.
    ENGINE_ROOTLESS=false
    USERNS_ARGS=()
    if [ "$ENGINE_CLI_FLAVOR" = "podman" ]; then
        if [ "$("$ENGINE_CMD" info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ]; then
            ENGINE_ROOTLESS=true
            USERNS_ARGS=("--userns=keep-id:uid=$HOST_UID,gid=$HOST_GID")
        fi
    else
        case "$("$ENGINE_CMD" info --format '{{join .SecurityOptions ","}}' 2>/dev/null)" in
            *name=rootless*) ENGINE_ROOTLESS=true ;;
        esac
    fi
}

get_dockerfile_content() {
    # Head: the only lines that interpolate wrapper settings. Everything below
    # is a quoted heredoc; the RUN steps read the versions from the ARGs.
    cat <<DOCKERFILE_HEAD
FROM ubuntu:${UBUNTU_VERSION}
ARG NODE_VERSION=${NODE_VERSION}
ARG PYTHON_VERSION=${PYTHON_VERSION}
ARG GO_VERSION=${GO_VERSION}
ARG RUST_VERSION=${RUST_VERSION}
ARG JAVA_VERSION=${JAVA_VERSION}
DOCKERFILE_HEAD

    cat <<'DOCKERFILE_END'
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl git git-lfs python3 build-essential ca-certificates gnupg sudo xz-utils unzip \
    libsecret-1-0 dbus dbus-x11 gnome-keyring \
    tree htop btop procps jq ripgrep fd-find bat vim nano wget zip rsync file lsof \
    dnsutils netcat-openbsd tmux sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && ln -s /usr/bin/batcat /usr/local/bin/bat
DOCKERFILE_END

    # Trust anchors go in before the first HTTPS fetch. One file per
    # certificate under /usr/local/share/ca-certificates (update-ca-certificates
    # indexes files, not bundles) feeds curl, apt, git, Python's ssl module and
    # podman via the system store. Tools that keep their own store get the
    # merged bundle explicitly: Node/npm and the Claude CLI (NODE_EXTRA_CA_CERTS),
    # the Codex CLI (SSL_CERT_FILE), requests and pip.
    if [ -n "$CA_BUNDLE_PATH" ]; then
        cat <<'DOCKERFILE_END'

# Extra trust anchors from SAGENT_CA_BUNDLE (a TLS-inspecting proxy's CA).
COPY sagent-ca/ /usr/local/share/ca-certificates/sagent/
COPY sagent-ca-bundle.pem /usr/local/share/sagent-ca-bundle.pem
RUN update-ca-certificates
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/sagent-ca-bundle.pem
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt
DOCKERFILE_END
    fi

    cat <<'DOCKERFILE_END'

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y gh && rm -rf /var/lib/apt/lists/*

# Node.js: the official tarball for the configured major (latest patch),
# independent of the distro's packaging.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) arch=x64 ;; \
        arm64) arch=arm64 ;; \
        *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    base="https://nodejs.org/dist/latest-v${NODE_VERSION}.x"; \
    tarball="$(curl -fsSL "$base/SHASUMS256.txt" | grep -o "node-v[0-9.]*-linux-${arch}.tar.xz" | head -1)"; \
    [ -n "$tarball" ]; \
    curl -fsSL "$base/$tarball" | tar -xJ -C /usr/local --strip-components=1 \
        --exclude CHANGELOG.md --exclude LICENSE --exclude README.md; \
    node --version && npm --version

# Python: a uv-managed CPython of the configured minor version (latest
# patch), installed system-wide ahead of the distro's own python3 on PATH.
# It ships pip; PIP_BREAK_SYSTEM_PACKAGES below lets `pip install --user`
# through uv's externally-managed marker into the sagent-pip volume.
RUN set -eux; \
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh; \
    UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install --default "${PYTHON_VERSION}"; \
    pybin="$(python3 -c 'import os, sys; print(os.path.join(sys.prefix, "bin"))')"; \
    ln -sf "$pybin/pip3" /usr/local/bin/pip3; \
    ln -sf "$pybin/pip3" /usr/local/bin/pip; \
    python3 --version && pip3 --version
# uv's Python is built against its own OpenSSL whose compiled-in CA file is
# /etc/ssl/cert.pem, which Ubuntu does not have. Point OpenSSL-based tools
# (Python's ssl module, the Codex CLI) at Ubuntu's bundle explicitly.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
DOCKERFILE_END

    if [ "$GO_VERSION" != "none" ]; then
        cat <<'DOCKERFILE_END'

# Go: official tarball; a major.minor resolves to its latest patch via go.dev.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in amd64) arch=amd64 ;; arm64) arch=arm64 ;; esac; \
    case "$GO_VERSION" in \
        *.*.*) release="go${GO_VERSION}" ;; \
        *) release="$(curl -fsSL 'https://go.dev/dl/?mode=json&include=all' \
            | grep -oE "\"version\": ?\"go${GO_VERSION}(\.[0-9]+)?\"" | head -1 | grep -oE 'go[0-9.]+')" ;; \
    esac; \
    [ -n "$release" ]; \
    curl -fsSL "https://go.dev/dl/${release}.linux-${arch}.tar.gz" | tar -xz -C /usr/local; \
    /usr/local/go/bin/go version
DOCKERFILE_END
    fi

    if [ "$RUST_VERSION" != "none" ]; then
        cat <<'DOCKERFILE_END'

# Rust: rustup with a system-wide toolchain (minimal profile plus rustfmt and
# clippy). RUSTUP_HOME stays system-wide and writable so the rustup proxies
# work for the agent; CARGO_HOME is left unset at runtime so registries and
# `cargo install` land in the persistent home directory.
RUN set -eux; \
    curl -fsSL https://sh.rustup.rs | env RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo \
        sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
        --component rustfmt --component clippy; \
    chmod -R a+w /opt/rust/rustup; \
    RUSTUP_HOME=/opt/rust/rustup /opt/rust/cargo/bin/cargo --version
ENV RUSTUP_HOME=/opt/rust/rustup
DOCKERFILE_END
    fi

    if [ "$JAVA_VERSION" != "none" ]; then
        cat <<'DOCKERFILE_END'

# Java: Eclipse Temurin JDK, latest GA build of the configured major.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in amd64) arch=x64 ;; arm64) arch=aarch64 ;; esac; \
    mkdir -p /opt/java; \
    curl -fsSL "https://api.adoptium.net/v3/binary/latest/${JAVA_VERSION}/ga/linux/${arch}/jdk/hotspot/normal/eclipse" \
        | tar -xz -C /opt/java --strip-components=1; \
    /opt/java/bin/java -version
ENV JAVA_HOME=/opt/java

DOCKERFILE_END
    fi

    # Java build tools and framework CLIs, latest stable at build time: Maven
    # and the Spring Boot CLI resolve the highest plain X.Y.Z from Maven
    # Central's metadata (its "release" pointer can be an RC or milestone),
    # Gradle from gradle.org's current-version endpoint, the Quarkus CLI from
    # its Maven Central release (the runnable uber jar behind a launcher).
    if tool_selected maven || tool_selected gradle || tool_selected quarkus || tool_selected spring; then
        local -a java_checks=()
        printf '\n# Java build tools and framework CLIs, latest stable at build time.\nRUN set -eux; \\\n'
        if tool_selected maven; then
            cat <<'DOCKERFILE_END'
    mvn_v="$(curl -fsSL https://repo1.maven.org/maven2/org/apache/maven/apache-maven/maven-metadata.xml \
        | grep -oE '<version>[0-9]+\.[0-9]+\.[0-9]+</version>' | sed 's/<[^>]*>//g' | sort -V | tail -1)"; \
    mkdir -p /opt/maven; \
    curl -fsSL "https://repo1.maven.org/maven2/org/apache/maven/apache-maven/${mvn_v}/apache-maven-${mvn_v}-bin.tar.gz" \
        | tar -xz -C /opt/maven --strip-components=1; \
DOCKERFILE_END
            java_checks+=("/opt/maven/bin/mvn -v")
        fi
        if tool_selected gradle; then
            cat <<'DOCKERFILE_END'
    gradle_url="$(curl -fsSL https://services.gradle.org/versions/current | grep -oE '"downloadUrl" *: *"[^"]+"' | grep -oE 'https://[^"]+')"; \
    curl -fsSL "$gradle_url" -o /tmp/gradle.zip; \
    unzip -q /tmp/gradle.zip -d /opt; \
    mv /opt/gradle-* /opt/gradle; \
    rm -f /tmp/gradle.zip; \
DOCKERFILE_END
            java_checks+=("/opt/gradle/bin/gradle --version")
        fi
        if tool_selected quarkus; then
            cat <<'DOCKERFILE_END'
    quarkus_v="$(curl -fsSL https://repo1.maven.org/maven2/io/quarkus/quarkus-cli/maven-metadata.xml | sed -n 's:.*<release>\(.*\)</release>.*:\1:p')"; \
    mkdir -p /opt/quarkus; \
    curl -fsSL "https://repo1.maven.org/maven2/io/quarkus/quarkus-cli/${quarkus_v}/quarkus-cli-${quarkus_v}-runner.jar" -o /opt/quarkus/quarkus-cli.jar; \
    printf '%s\n' '#!/bin/sh' 'exec "${JAVA_HOME:-/opt/java}/bin/java" -jar /opt/quarkus/quarkus-cli.jar "$@"' > /usr/local/bin/quarkus; \
    chmod 0755 /usr/local/bin/quarkus; \
DOCKERFILE_END
            java_checks+=("/usr/local/bin/quarkus --version")
        fi
        if tool_selected spring; then
            cat <<'DOCKERFILE_END'
    spring_v="$(curl -fsSL https://repo1.maven.org/maven2/org/springframework/boot/spring-boot-cli/maven-metadata.xml \
        | grep -oE '<version>[0-9]+\.[0-9]+\.[0-9]+</version>' | sed 's/<[^>]*>//g' | sort -V | tail -1)"; \
    mkdir -p /opt/spring; \
    curl -fsSL "https://repo1.maven.org/maven2/org/springframework/boot/spring-boot-cli/${spring_v}/spring-boot-cli-${spring_v}-bin.tar.gz" \
        | tar -xz -C /opt/spring --strip-components=1; \
DOCKERFILE_END
            java_checks+=("/opt/spring/bin/spring --version")
        fi
        printf '    %s\n' "$(IFS=';'; printf '%s' "${java_checks[*]}" | sed 's/;/; /g')"
    fi

    cat <<'DOCKERFILE_END'

# Nested container tooling (used by the wrappers' --docker mode): rootless
# podman with the docker CLI shim, confined entirely to the sandbox. passt
# provides pasta, podman 5's default rootless network backend.
RUN apt-get update && apt-get install -y \
    podman podman-docker passt slirp4netns fuse-overlayfs \
    && rm -rf /var/lib/apt/lists/*
DOCKERFILE_END

    # The selected JavaScript/TypeScript tooling, each at its latest release.
    # React, Next.js, htmx and shadcn components are project dependencies
    # these scaffolders pull in. yarn and pnpm come through corepack, which
    # serves whatever version a project's packageManager field declares (Node
    # no longer bundles corepack). The two agent CLIs are deliberately not
    # here: they release almost daily and go in the last layer instead.
    local -a npm_tools=()
    local tool
    for tool in typescript tsx bun corepack create-next-app create-vite shadcn; do
        if tool_selected "$tool"; then npm_tools+=("$tool"); fi
    done
    if [ "${#npm_tools[@]}" -gt 0 ]; then
        printf '\n# JavaScript/TypeScript tooling.\nRUN npm install -g'
        printf ' %s' "${npm_tools[@]}"
        printf '\n'
    fi
    if tool_selected corepack; then
        printf 'RUN corepack enable --install-directory /usr/local/bin\nENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0\n'
    fi

    cat <<'DOCKERFILE_END'

ARG USER_UID=1000
ARG USER_GID=1000
# ubuntu images ship a default "ubuntu" user with UID/GID 1000. On hosts where
# the invoking user is UID 1000 (the common Linux desktop case), sudo resolves
# the UID to that first passwd entry, so the "agent" sudoers rule never applies.
# Remove it before creating agent.
RUN set -eux; \
    userdel -r ubuntu; \
    if getent group "${USER_GID}" >/dev/null; then \
        USER_GROUP="$(getent group "${USER_GID}" | cut -d: -f1)"; \
    else \
        groupadd -g "${USER_GID}" agent; \
        USER_GROUP=agent; \
    fi; \
    useradd -o -u "${USER_UID}" -g "${USER_GROUP}" -m -s /bin/bash agent; \
    echo 'agent ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt, /usr/bin/dpkg' > /etc/sudoers.d/agent; \
    chmod 0440 /etc/sudoers.d/agent

# Nested podman configuration for --docker mode. Single-uid rootless mapping:
# drop the subuid/subgid ranges useradd created so podman never invokes the
# setuid newuidmap helper (which would need CAP_SYS_ADMIN under the sandbox's
# capability drop); ignore_chown_errors makes multi-uid images extract cleanly
# under the single mapping. pidns=host keeps nested containers in the sandbox's
# pid namespace so the runtime never needs a fresh /proc mount (the outer
# engine's masked /proc forbids one). default_sysctls=[] because the outer
# /proc/sys is read-only. nodocker silences the docker-shim notice, and the
# shim clamps podman's log level: the single-mapping rootless startup
# warnings are benign by design here and only add noise to every nested run.
RUN set -eux; \
    sed -i '/^agent:/d' /etc/subuid /etc/subgid; \
    touch /etc/containers/nodocker; \
    printf '%s\n' '#!/bin/sh' 'exec /usr/bin/podman --log-level=error "$@"' > /usr/bin/docker; \
    chmod 0755 /usr/bin/docker; \
    printf '[containers]\ndefault_sysctls = []\npidns = "host"\n[engine]\nevents_logger = "file"\ncgroup_manager = "cgroupfs"\n' > /etc/containers/containers.conf; \
    printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nignore_chown_errors = "true"\n' > /etc/containers/storage.conf

# Browser-open shim: the sandbox has no browser, but the user's terminal can
# open links on the host (Cmd/Ctrl+click). Render every xdg-open/$BROWSER
# request as an OSC 8 hyperlink plus plain URL on the controlling terminal so
# login flows (claude, codex, gh auth) reach the host browser via a click.
# Claude Code hands the opener its localhost-callback sign-in URL; that
# callback can never reach a listener inside the sandbox, so the shim swaps
# in the manual-code redirect Claude Code itself prints as the fallback: the
# page then shows a code, and the CLI accepts it at its "Paste code here"
# prompt (its token exchange uses that redirect whenever the local listener
# saw nothing) (#78).
RUN set -eux; \
    printf '%s\n' \
        '#!/bin/sh' \
        '# sagent host-open: print browser-open requests as clickable links.' \
        '# Probe in a subshell: without a controlling terminal /dev/tty exists' \
        '# and is permission-writable but cannot be opened, and a failed exec' \
        '# redirect would kill the script.' \
        'if ( exec > /dev/tty ) 2>/dev/null; then' \
        '    exec > /dev/tty' \
        'else' \
        '    exec >&2' \
        'fi' \
        'for url in "$@"; do' \
        '    note=""' \
        '    case "$url" in' \
        '        *oauth/authorize*redirect_uri=http%3A%2F%2Flocalhost%3A*%2Fcallback*)' \
        '            url=$(printf %s "$url" | sed -E "s#redirect_uri=http%3A%2F%2Flocalhost%3A[0-9]+%2Fcallback#redirect_uri=https%3A%2F%2Fplatform.claude.com%2Foauth%2Fcode%2Fcallback#")' \
        '            case "$url" in *code=true*) ;; *) url="$url&code=true" ;; esac' \
        '            note="Sign in there, then paste the code the page shows at the prompt below (a browser cannot call back into the sandbox)."' \
        '            ;;' \
        '    esac' \
        '    printf '"'"'\n[sagent] Open in your browser (Cmd/Ctrl+click):\n'"'"'' \
        '    printf '"'"'\033]8;;%s\033\\%s\033]8;;\033\\\n'"'"' "$url" "$url"' \
        '    if [ -n "$note" ]; then printf '"'"'[sagent] %s\n'"'"' "$note"; fi' \
        '    printf '"'"'\n'"'"'' \
        'done' \
        > /usr/local/bin/host-open; \
    chmod 0755 /usr/local/bin/host-open; \
    ln -s host-open /usr/local/bin/xdg-open

# Clipboard shims: pbcopy, pbpaste, wl-copy, wl-paste, xclip and xsel (what
# the Claude and Codex CLIs and everyday scripts call) are one script that
# talks to the wrapper's clipboard agent on the host through the bridge
# directory mounted at /run/sagent/clipboard: copy, read as text, list the
# available targets, read a PNG. The host agent runs pbcopy/pbpaste/osascript
# (macOS) or wl-copy/wl-paste or xclip (Linux). Without the bridge (the image
# run on its own) a copy goes to the controlling terminal as OSC 52 and reads
# fail with a message.
RUN set -eux; \
    printf '%s\n' \
        '#!/bin/sh' \
        '# sagent host-clipboard: the sandbox'"'"'s clipboard commands, served by the host.' \
        '# With the wrapper'"'"'s bridge mounted, requests go to the host clipboard agent' \
        '# through /run/sagent/clipboard (copy, text, target list, PNG). Without it' \
        '# (the image run on its own), copy goes out as OSC 52 and reads fail.' \
        'bridge=/run/sagent/clipboard' \
        'name=$(basename "$0")' \
        'mode=copy' \
        'target=text' \
        'prev=""' \
        'for a in "$@"; do' \
        '    case "$prev" in' \
        '        -t|-ta|-tar|-targ|-targe|-target|--type)' \
        '            case "$a" in' \
        '                TARGETS) target=targets ;;' \
        '                image/png) target=image/png ;;' \
        '                text/plain*|UTF8_STRING|STRING|text) target=text ;;' \
        '                *) target="unsupported:$a" ;;' \
        '            esac' \
        '            ;;' \
        '    esac' \
        '    case "$a" in' \
        '        -o|-ou|-out|--output) mode="paste" ;;' \
        '        -l|--list-types) mode="paste"; target=targets ;;' \
        '    esac' \
        '    prev="$a"' \
        'done' \
        'case "$name" in pbpaste|wl-paste) mode="paste" ;; esac' \
        '' \
        'fail() { echo "[sagent] $name: $1" >&2; exit 1; }' \
        'wait_gone() {' \
        '    i=0' \
        '    while [ -e "$1" ]; do' \
        '        i=$((i + 1))' \
        '        [ "$i" -le 100 ] || fail "the host clipboard agent did not answer in 10s (it runs alongside the wrapper; not available from a plain docker exec of an older session)"' \
        '        sleep 0.1' \
        '    done' \
        '}' \
        '' \
        'if [ "$mode" = copy ]; then' \
        '    if [ -d "$bridge" ]; then' \
        '        id="$$-$(od -An -N4 -tu4 /dev/urandom | tr -d '"'"' '"'"')"' \
        '        cat > "$bridge/req-$id.tmp"' \
        '        mv "$bridge/req-$id.tmp" "$bridge/req-$id.copy"' \
        '        wait_gone "$bridge/req-$id.copy"' \
        '        exit 0' \
        '    fi' \
        '    data=$(base64 -w0)' \
        '    if ( exec > /dev/tty ) 2>/dev/null; then' \
        '        exec > /dev/tty' \
        '    else' \
        '        exec >&2' \
        '    fi' \
        '    printf '"'"'\033]52;c;%s\033\\'"'"' "$data"' \
        '    exit 0' \
        'fi' \
        '' \
        '[ -d "$bridge" ] || fail "the host clipboard is not readable here (no clipboard bridge: the image is running without the wrapper). Paste text with Cmd/Ctrl+V."' \
        'case "$target" in unsupported:*) fail "unsupported clipboard target ${target#unsupported:}" ;; esac' \
        'id="$$-$(od -An -N4 -tu4 /dev/urandom | tr -d '"'"' '"'"')"' \
        'printf '"'"'%s\n'"'"' "$target" > "$bridge/req-$id.tmp"' \
        'mv "$bridge/req-$id.tmp" "$bridge/req-$id.paste"' \
        'i=0' \
        'while [ ! -e "$bridge/res-$id.ok" ] && [ ! -e "$bridge/res-$id.fail" ]; do' \
        '    i=$((i + 1))' \
        '    [ "$i" -le 100 ] || { rm -f "$bridge/req-$id.paste"; fail "the host clipboard agent did not answer in 10s"; }' \
        '    sleep 0.1' \
        'done' \
        'if [ -e "$bridge/res-$id.ok" ]; then' \
        '    cat "$bridge/res-$id.ok"' \
        '    rm -f "$bridge/res-$id.ok"' \
        '    exit 0' \
        'fi' \
        'rm -f "$bridge/res-$id.fail"' \
        'fail "the host clipboard has no $target"' \
        > /usr/local/bin/host-clipboard; \
    chmod 0755 /usr/local/bin/host-clipboard; \
    for n in pbcopy pbpaste wl-copy wl-paste xclip xsel; do ln -s host-clipboard "/usr/local/bin/$n"; done

# git on the host's behalf: gh serves the credentials it holds (synced from
# the host's gh login, or GH_TOKEN) to git for GitHub over HTTPS. Whether
# SSH remotes are rewritten to HTTPS is decided per run (SAGENT_GIT_PROTOCOL)
# in the synced git config. The host's own credential helpers and signing
# settings are not carried over.
RUN set -eux; \
    git config --system credential.https://github.com.helper '!gh auth git-credential'; \
    git config --system credential.https://gist.github.com.helper '!gh auth git-credential'; \
    git lfs install --system --skip-repo

# Every path a volume mounts on exists here, owned by agent. An engine that
# has to create a missing mount point makes it root-owned, and the sandbox
# user cannot write to its own home directory; a fresh volume mounted on an
# existing directory takes that directory's ownership instead.
RUN set -eux; \
    mkdir -p /workspace \
        /home/agent/.npm-global \
        /home/agent/.local/bin \
        /home/agent/.local/share/containers; \
    chown -R agent /workspace /home/agent

USER agent
ENV BROWSER=/usr/local/bin/host-open
WORKDIR /workspace
ENV HOME=/home/agent
ENV TMPDIR=/tmp
ENV LANG=C.UTF-8
# uv's Python carries an externally-managed marker (PEP 668) that would block
# even `pip install --user` into the dedicated pip volume. The sandbox is
# disposable, so let pip install into the user site freely.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV NPM_CONFIG_PREFIX=/home/agent/.npm-global
# Persistent, user-writable install locations first (npm globals, pip user
# scripts, cargo install, go install), then the system-wide toolchains.
ENV PATH="/home/agent/.npm-global/bin:/home/agent/.local/bin:/home/agent/.cargo/bin:/home/agent/go/bin:/usr/local/go/bin:/opt/rust/cargo/bin:/opt/java/bin:/opt/maven/bin:/opt/gradle/bin:/opt/spring/bin:${PATH}"

# The agent CLIs come last, and alone: they release almost daily, while
# everything above them changes a few times a year. AGENT_CLI_REFRESH is not
# part of the image hash; `update` passes the new version pair to rebuild
# this one layer from a cached image instead of the whole thing.
USER root
ARG AGENT_CLI_REFRESH=initial
# NPM_CONFIG_PREFIX is set above for the agent's runtime npm (a volume at
# /home/agent/.npm-global): install into the system prefix instead, or the
# CLIs would land where that volume later hides them.
RUN echo "agent CLIs: ${AGENT_CLI_REFRESH}" && NPM_CONFIG_PREFIX=/usr/local npm install -g @anthropic-ai/claude-code @openai/codex
USER agent
DOCKERFILE_END
}

# The hash covers image content only: the Dockerfile, the UID/GID build args
# and the CA bundle that gets COPYed in. Runtime limits (memory/cpu/pids) are
# container run flags — including them here forced a full rebuild whenever a
# limit was tuned.
get_version_hash() {
    {
        get_dockerfile_content
        echo "USER_UID=$HOST_UID"
        echo "USER_GID=$HOST_GID"
        if [ -n "$CA_BUNDLE_PATH" ]; then
            echo "CA_BUNDLE_SHA256=$(portable_sha256 < "$CA_BUNDLE_PATH")"
        fi
    } | portable_sha256 | cut -c1-8
}

VERSION_HASH=$(get_version_hash)
IMAGE_NAME="${IMAGE_REPO}:${VERSION_HASH}"

# The build metadata (version hash and build time) that `version` and
# `doctor` read back. Labels, not a file: a RUN writing a file is a new
# filesystem layer on every build, and one new layer costs a full image
# export and unpack (minutes on a VM-backed engine) even when every other
# layer was cached.
dockerfile_metadata_block() {
    local build_timestamp
    build_timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    cat <<EOF

LABEL sagent.version="$VERSION_HASH" sagent.build_timestamp="$build_timestamp"
EOF
}

# The metadata of a built image, as JSON, from its labels.
image_metadata() {
    "$ENGINE_CMD" image inspect "$IMAGE_NAME" \
        --format '{"version": "{{index .Config.Labels "sagent.version"}}", "build_timestamp": "{{index .Config.Labels "sagent.build_timestamp"}}"}' 2>/dev/null || true
}

# `dockerfile`: print the Dockerfile a build would use, for building the
# image elsewhere (the release workflow publishes it for both
# architectures). SAGENT_IMAGE_UID/SAGENT_IMAGE_GID pick the user the
# image is built for when it is not the one running this; the version hash
# in the metadata follows, so the printed file is what a wrapper run by
# that user would build. Pass the same ids as USER_UID/USER_GID build args.
dockerfile_command() {
    if [ -n "${SAGENT_IMAGE_UID:-}" ] || [ -n "${SAGENT_IMAGE_GID:-}" ]; then
        HOST_UID="${SAGENT_IMAGE_UID:-$HOST_UID}"
        HOST_GID="${SAGENT_IMAGE_GID:-$HOST_GID}"
        VERSION_HASH=$(get_version_hash)
    fi
    get_dockerfile_content
    dockerfile_metadata_block
}

# Extra `--build-arg` pairs for the next build (set by `update` to refresh
# only the agent-CLI layer).
BUILD_EXTRA_ARGS=()

build_image() {
    local no_cache="${1:-}"
    local temp_context
    local temp_dockerfile
    local build_timestamp
    local build_args=()

    if [ "$no_cache" = "--no-cache" ]; then
        echo "[$SCRIPT_NAME] Updating shared sandbox image (version: $VERSION_HASH)..." >&2
        build_args+=("--no-cache" "--pull")
    else
        echo "[$SCRIPT_NAME] Building shared sandbox image (version: $VERSION_HASH)..." >&2
    fi

    # Export semantics depend on engine flavor. A real docker CLI on a docker
    # server builds via buildx, and a docker-container/cloud builder keeps the
    # result in the build cache unless --load exports it to the image store. A
    # real docker CLI on a podman server cannot use buildx: select the classic
    # builder endpoint podman implements (DOCKER_BUILDKIT=0), which takes no
    # --load. A podman CLI always loads locally and has no such flag.
    local -a build_env=()
    if [ "$ENGINE_CLI_FLAVOR" = "docker" ]; then
        if [ "$ENGINE_SERVER_FLAVOR" = "docker" ]; then
            build_args+=("--load")
        else
            build_env=(env DOCKER_BUILDKIT=0)
        fi
    fi

    # Build from a fresh temp directory holding only the Dockerfile and the
    # optional CA bundle: using the wrapper's own directory as context would tar
    # and send everything next to the installed script (e.g. all of
    # /usr/local/bin, or a repo checkout with its .git) to the daemon on every
    # build.
    temp_context=$(mktemp -d)
    TEMP_FILES+=("$temp_context")
    temp_dockerfile="$temp_context/Dockerfile"
    get_dockerfile_content > "$temp_dockerfile"
    if [ -n "$CA_BUNDLE_PATH" ]; then
        stage_ca_bundle "$temp_context"
    fi

    # Detect TLS interception and take the CA from the host before spending
    # minutes on a build that would fail at its first HTTPS fetch. Regenerate
    # the Dockerfile and context afterwards: the bundle changes both.
    ensure_build_tls
    get_dockerfile_content > "$temp_dockerfile"
    if [ -n "$CA_BUNDLE_PATH" ] && [ ! -d "$temp_context/sagent-ca" ]; then
        stage_ca_bundle "$temp_context"
    fi

    dockerfile_metadata_block >> "$temp_dockerfile"

    if ! "${build_env[@]+"${build_env[@]}"}" "$ENGINE_CMD" build "${build_args[@]+"${build_args[@]}"}" \
        "${BUILD_EXTRA_ARGS[@]+"${BUILD_EXTRA_ARGS[@]}"}" \
        --build-arg USER_UID="$HOST_UID" \
        --build-arg USER_GID="$HOST_GID" \
        -t "$IMAGE_NAME" \
        -f "$temp_dockerfile" \
        "$temp_context"; then
        print_build_failure_guidance
        exit 1
    fi

    rm -rf "$temp_context"

    echo "[$SCRIPT_NAME] Shared sandbox image ready" >&2
}

# Copy the CA bundle into the build context: the merged file for tools that
# take a single bundle path, plus one .crt per certificate because Debian's
# update-ca-certificates registers each file as one certificate (a multi-cert
# file would only contribute its first certificate to the hashed store).
stage_ca_bundle() {
    local context="$1"
    local split_dir="$context/sagent-ca"

    mkdir -p "$split_dir"
    cp "$CA_BUNDLE_PATH" "$context/sagent-ca-bundle.pem"
    awk -v dir="$split_dir" '
        /-----BEGIN CERTIFICATE-----/ { n++; f = sprintf("%s/sagent-%03d.crt", dir, n) }
        f { print > f }
        /-----END CERTIFICATE-----/ { close(f); f = "" }
    ' "$CA_BUNDLE_PATH"
    echo "[$SCRIPT_NAME] Baking $CA_BUNDLE_CERT_COUNT CA certificate(s) from $CA_BUNDLE_PATH into the image" >&2
}

# Free space in the engine's storage, in GiB (empty when it cannot be read).
# Measured inside a container: on a VM-backed engine the pool that fills up is
# the VM disk, which the host cannot see.
engine_disk_free_gb() {
    "$ENGINE_CMD" run --rm "ubuntu:${UBUNTU_VERSION}" \
        sh -c "df -Pk / | awk 'NR==2 {print int(\$4/1048576)}'" </dev/null 2>/dev/null | tr -cd '0-9'
}

# The image needs roughly this much free space in the engine to build.
DISK_FREE_GB_MIN=8

print_disk_guidance() {
    local free="$1"
    echo "[$SCRIPT_NAME] The engine has ${free} GiB free where it stores images; a build needs about $DISK_FREE_GB_MIN GiB." >&2
    echo "[$SCRIPT_NAME] Reclaim space: \`$SCRIPT_NAME cleanup\` (old sandbox images), \`$SCRIPT_NAME reset-caches\`, \`$ENGINE_CMD image prune -f\`, \`$ENGINE_CMD system df\` to see what is left." >&2
    if [ "$(uname -s)" = "Darwin" ]; then
        echo "[$SCRIPT_NAME] On a VM-backed engine the space freed inside the VM reaches the host only after a trim: \`podman machine ssh sudo fstrim -av\` (podman), or restart the VM (colima, Rancher Desktop, Docker Desktop)." >&2
    fi
}

print_build_failure_guidance() {
    local free
    echo "[$SCRIPT_NAME] ERROR: sandbox image build failed (engine output above)." >&2
    free=$(engine_disk_free_gb)
    if [ -n "$free" ] && [ "$free" -lt "$DISK_FREE_GB_MIN" ]; then
        echo "[$SCRIPT_NAME] The engine is out of disk, which is the likely cause (a \"no space left on device\" error above confirms it)." >&2
        print_disk_guidance "$free"
        return 0
    fi
    echo "[$SCRIPT_NAME] TLS interception was checked before the build$([ -n "$CA_BUNDLE_PATH" ] && echo " with SAGENT_CA_BUNDLE=$CA_BUNDLE_PATH ($CA_BUNDLE_CERT_COUNT certificate(s))"), so a TLS error above means a host this build fetches from is handled differently by the proxy; \`$SCRIPT_NAME doctor\` reports the CA the network presents." >&2
    echo "[$SCRIPT_NAME] Any other error above is from the build step itself; rerun with \`$SCRIPT_NAME --build\` after fixing what it names." >&2
}

ensure_image() {
    if ! "$ENGINE_CMD" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        echo "[$SCRIPT_NAME] Shared sandbox image not found (version: $VERSION_HASH), building..." >&2
        build_image
    fi
}

show_version() {
    local meta
    local tool_version

    echo "Script: $SCRIPT_NAME"
    echo "Wrapper version: v$WRAPPER_VERSION"
    echo "Engine: $ENGINE_CMD (CLI: $ENGINE_CLI_FLAVOR, server: $ENGINE_SERVER_FLAVOR, rootless: $ENGINE_ROOTLESS)"
    echo "Sandbox image: $IMAGE_NAME"
    echo "Image hash: $VERSION_HASH"
    echo "Limits: memory=$MEMORY_LIMIT cpus=$CPU_LIMIT pids=$PIDS_LIMIT pids-nested=$PIDS_LIMIT_NESTED"
    echo "Toolchain: ubuntu=$UBUNTU_VERSION node=$NODE_VERSION python=$PYTHON_VERSION go=$GO_VERSION rust=$RUST_VERSION java=$JAVA_VERSION"
    echo "Tools: ${TOOLS_SELECTED:-none}"
    if [ -n "$CA_BUNDLE_PATH" ]; then
        echo "CA bundle: $CA_BUNDLE_PATH ($CA_BUNDLE_CERT_COUNT certificate(s))"
    else
        echo "CA bundle: none (SAGENT_CA_BUNDLE unset)"
    fi
    if "$ENGINE_CMD" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        tool_version=$("$ENGINE_CMD" run --rm "$IMAGE_NAME" "$TOOL_BIN" --version 2>/dev/null || echo "unknown")
        echo "$TOOL_NAME CLI: $tool_version"
        echo "Container metadata:"
        meta=$(image_metadata)
        if [ -n "$meta" ]; then
            if command -v python3 >/dev/null 2>&1; then
                printf '%s' "$meta" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$meta"
            else
                printf '%s\n' "$meta"
            fi
        fi
    else
        echo "Container image not built yet"
    fi
}

cleanup_images() {
    echo "[$SCRIPT_NAME] Current version: $VERSION_HASH" >&2
    echo "[$SCRIPT_NAME] Removing old $IMAGE_REPO images..." >&2
    "$ENGINE_CMD" images "$IMAGE_REPO" --format "{{.Tag}}" \
        | { grep -vE "^($VERSION_HASH|latest)$" || true; } \
        | while read -r tag; do
        if [ -n "$tag" ]; then
            echo "  Removing $IMAGE_REPO:$tag" >&2
            "$ENGINE_CMD" rmi "$IMAGE_REPO:$tag" 2>&1 | grep -vE "^(Untagged|Deleted):" >&2 || true
        fi
    done
    if [ "$ENGINE_CLI_FLAVOR" = "docker" ] && [ "$ENGINE_SERVER_FLAVOR" = "docker" ]; then
        echo "[$SCRIPT_NAME] Note: --no-cache rebuilds accumulate buildx cache; run \`docker builder prune\` to reclaim it." >&2
    fi
    echo "[$SCRIPT_NAME] Cleanup complete" >&2
}

# Human-readable size (docker/podman style) to bytes, for totals.
size_to_bytes() {
    awk -v s="$1" 'BEGIN {
        n = s; sub(/[^0-9.].*$/, "", n); u = s; sub(/^[0-9.]+/, "", u); u = tolower(u);
        m = 1;
        if (u ~ /^k/) m = 1000; else if (u ~ /^m/) m = 1000000; else if (u ~ /^g/) m = 1000000000; else if (u ~ /^t/) m = 1000000000000;
        printf "%.0f", n * m }'
}

bytes_to_size() {
    awk -v b="$1" 'BEGIN {
        if (b >= 1000000000) printf "%.2fGB", b / 1000000000;
        else if (b >= 1000000) printf "%.1fMB", b / 1000000;
        else if (b >= 1000) printf "%.1fkB", b / 1000;
        else printf "%dB", b }'
}

# Disk usage report: images, every volume with its purpose and size, and the
# caches total that `reset-caches` would reclaim.
show_volumes() {
    local df_output volume_rows tag size total_cache=0 total_all=0 bytes cache_flag
    local name purpose

    echo "[$SCRIPT_NAME] Disk usage (engine: $ENGINE_CMD)"
    echo "Images ($IMAGE_REPO):"
    "$ENGINE_CMD" images "$IMAGE_REPO" --format '{{.Tag}} {{.Size}}' 2>/dev/null | while read -r tag size; do
        if [ "$tag" = "$VERSION_HASH" ]; then
            printf '  %-20s %-10s current\n' "$tag" "$size"
        else
            printf '  %-20s %-10s old, remove with: %s cleanup\n' "$tag" "$size" "$SCRIPT_NAME"
        fi
    done

    # `system df -v` is the only engine command that reports volume sizes; both
    # docker and podman print a "VOLUME NAME  LINKS  SIZE" table in it.
    df_output=$("$ENGINE_CMD" system df -v 2>/dev/null || true)
    volume_rows=$(printf '%s\n' "$df_output" | awk '/^VOLUME NAME/ {in_table = 1; next} in_table && NF == 0 {in_table = 0} in_table {print $1, $NF}')

    echo "Volumes:"
    while IFS='|' read -r name purpose cache_flag; do
        if ! "$ENGINE_CMD" volume inspect "$name" >/dev/null 2>&1; then
            size="(not created)"
        else
            size=$(printf '%s\n' "$volume_rows" | awk -v n="$name" '$1 == n {print $2; exit}')
            size="${size:-n/a}"
        fi
        case "$size" in
            *[0-9]*B) bytes=$(size_to_bytes "$size") ;;
            *) bytes=0 ;;
        esac
        total_all=$((total_all + bytes))
        if [ "$cache_flag" = "cache" ]; then
            total_cache=$((total_cache + bytes))
            printf '  %-20s %-10s %s [cache]\n' "$name" "$size" "$purpose"
        else
            printf '  %-20s %-10s %s\n' "$name" "$size" "$purpose"
        fi
    done <<EOF
sclaude-config|Claude credentials, config, sessions|
scodex-config|Codex auth and config|
$ROOTFS_VOLUME|home directory: shell state, gh auth, Go/Rust/Java caches|
$NPM_VOLUME|npm global packages|cache
$PIP_VOLUME|pip user packages|cache
$SHARE_VOLUME|uv tools and uv-managed Pythons, other XDG data|
$APT_CACHE_VOLUME|apt package downloads|cache
$APT_LISTS_VOLUME|apt package indexes|cache
$CONTAINERS_VOLUME|nested container images and state|cache
EOF
    echo "Volumes total: $(bytes_to_size "$total_all"); caches: $(bytes_to_size "$total_cache")"
    echo "\`$SCRIPT_NAME reset-caches\` clears the [cache] volumes and keeps credentials, config and the home directory; \`$SCRIPT_NAME reset\` removes everything."
}

# Remove containers that are not running but still pin the sandbox volumes
# (e.g. --rm containers that failed to start), so volume removal can succeed.
remove_stale_sandbox_containers() {
    "$ENGINE_CMD" ps -a --format '{{.ID}} {{.Image}} {{.State}}' 2>/dev/null \
        | awk -v repo="$IMAGE_REPO" '$2 ~ "^"repo":" && $3 != "running" {print $1}' \
        | while read -r cid; do
            "$ENGINE_CMD" rm -v "$cid" >/dev/null 2>&1 || true
        done
}

# Remove the named volumes; exits non-zero naming any volume still pinned by a
# running container.
remove_volumes() {
    local v leftover=""
    for v in "$@"; do
        if "$ENGINE_CMD" volume inspect "$v" >/dev/null 2>&1 \
            && ! "$ENGINE_CMD" volume rm "$v" >/dev/null 2>&1; then
            leftover="$leftover $v"
        fi
    done
    if [ -n "$leftover" ]; then
        echo "[$SCRIPT_NAME] WARNING: still in use by a container, not removed:$leftover" >&2
        exit 1
    fi
}

confirm_or_exit() {
    if [ "${SAGENT_ASSUME_YES:-}" != "1" ]; then
        if [ ! -t 0 ]; then
            echo "[$SCRIPT_NAME] ERROR: refusing to delete volumes non-interactively. Set SAGENT_ASSUME_YES=1 to override." >&2
            exit 1
        fi
        echo "[$SCRIPT_NAME] Press Ctrl+C to cancel, or Enter to continue..." >&2
        read -r
    fi
}

reset_caches() {
    echo "[$SCRIPT_NAME] This clears the cache volumes (npm globals, pip packages, apt cache, nested container images). Credentials, config and the home directory are kept." >&2
    confirm_or_exit
    echo "[$SCRIPT_NAME] Removing cache volumes..." >&2
    remove_stale_sandbox_containers
    remove_volumes "$NPM_VOLUME" "$PIP_VOLUME" "$APT_CACHE_VOLUME" "$APT_LISTS_VOLUME" "$CONTAINERS_VOLUME"
    echo "[$SCRIPT_NAME] Caches cleared. They are recreated on the next run." >&2
}

# ---- `tools` and `config` commands: inspect and edit the text config ----

setting_source() {
    local src
    eval "src=\${SAGENT_SOURCE_$1:-default}"
    printf '%s' "$src"
}

# Write KEY="VALUE" into the config file (replacing an existing KEY= line),
# validating the result parses before it replaces the original.
config_write() {
    local key="$1" value="$2" tmp escaped
    mkdir -p "$(dirname "$SAGENT_CONFIG_FILE")"
    tmp=$(mktemp)
    TEMP_FILES+=("$tmp")
    if [ -f "$SAGENT_CONFIG_FILE" ]; then
        grep -vE "^${key}=" "$SAGENT_CONFIG_FILE" > "$tmp" || true
    fi
    if [ -n "$value" ]; then
        escaped=$(printf '%s' "$value" | sed 's/[\\"]/\\&/g')
        printf '%s="%s"\n' "$key" "$escaped" >> "$tmp"
    fi
    if ! bash -n "$tmp" 2>/dev/null; then
        echo "[$SCRIPT_NAME] ERROR: refusing to write a config file that does not parse" >&2
        exit 1
    fi
    mv "$tmp" "$SAGENT_CONFIG_FILE"
}

config_key_known() {
    case " ${SAGENT_SETTINGS[*]} ${SAGENT_TUNABLES[*]} " in *" $1 "*) return 0 ;; esac
    return 1
}

# Validate a value for a key the same way startup does; exits on failure.
config_validate() {
    local key="$1" value="$2"
    case "$key" in
        SAGENT_UBUNTU_VERSION) validate_version_setting "$key" "$value" '^[0-9]{2}\.[0-9]{2}$' 'a release like 26.04' ;;
        SAGENT_NODE_VERSION) validate_version_setting "$key" "$value" '^[0-9]+$' 'a major version like 26' ;;
        SAGENT_PYTHON_VERSION) validate_version_setting "$key" "$value" '^3\.[0-9]+$' 'a minor version like 3.14' ;;
        SAGENT_GO_VERSION) validate_version_setting "$key" "$value" '^(none|1\.[0-9]+(\.[0-9]+)?)$' '1.27, 1.27.1, or none' ;;
        SAGENT_RUST_VERSION) validate_version_setting "$key" "$value" '^(none|stable|beta|nightly|[0-9]+\.[0-9]+(\.[0-9]+)?)$' 'stable, beta, nightly, 1.98.0, or none' ;;
        SAGENT_JAVA_VERSION) validate_version_setting "$key" "$value" '^(none|[0-9]+)$' 'a major version like 26, or none' ;;
        SAGENT_TOOLS) resolve_tools "$value" ;;
        SAGENT_DOCKER) validate_version_setting "$key" "$value" '^[01]$' '0 or 1' ;;
        SAGENT_CONTAINER_ENGINE) validate_version_setting "$key" "$value" '^(docker|podman)$' 'docker or podman' ;;
        SAGENT_GIT_PROTOCOL) validate_version_setting "$key" "$value" '^(ssh|https)$' 'ssh or https' ;;
        SAGENT_CLIPBOARD) validate_version_setting "$key" "$value" '^[01]$' '0 or 1' ;;
        SAGENT_CA_BUNDLE) ;;
        MEMORY_LIMIT) validate_version_setting "$key" "$value" '^[0-9]+[kmgKMG]?$' 'a size like 8g' ;;
        CPU_LIMIT) validate_version_setting "$key" "$value" '^[0-9]+(\.[0-9]+)?$' 'a number like 4' ;;
        PIDS_LIMIT | PIDS_LIMIT_NESTED) validate_version_setting "$key" "$value" '^[0-9]+$' 'a number like 200' ;;
    esac
}

config_command() {
    local sub="${1:-}" key value
    case "$sub" in
        "" | list)
            echo "Config file: $SAGENT_CONFIG_FILE$([ -f "$SAGENT_CONFIG_FILE" ] || echo ' (not created yet)')"
            echo "Effective settings (source: env > config > default):"
            for key in "${SAGENT_SETTINGS[@]}"; do
                eval "value=\${$key:-}"
                printf '  %-26s %-40s %s\n' "$key" "${value:-(unset)}" "$(setting_source "$key")"
            done
            for key in "${SAGENT_TUNABLES[@]}"; do
                eval "value=\${$key}"
                printf '  %-26s %-40s %s\n' "$key" "$value" "$(grep -qE "^${key}=" "$SAGENT_CONFIG_FILE" 2>/dev/null && echo config || echo default)"
            done
            echo "Usage: $SCRIPT_NAME config set KEY VALUE | unset KEY | get KEY | path"
            ;;
        path) echo "$SAGENT_CONFIG_FILE" ;;
        get)
            key="${2:-}"
            if ! config_key_known "$key"; then echo "[$SCRIPT_NAME] ERROR: unknown setting: $key" >&2; exit 1; fi
            eval "value=\${$key:-}"
            printf '%s\n' "$value"
            ;;
        set)
            key="${2:-}"; value="${3-}"
            if [ -z "$key" ] || [ $# -lt 3 ]; then echo "[$SCRIPT_NAME] Usage: $SCRIPT_NAME config set KEY VALUE" >&2; exit 1; fi
            if ! config_key_known "$key"; then
                echo "[$SCRIPT_NAME] ERROR: unknown setting: $key" >&2
                echo "[$SCRIPT_NAME] Settings: ${SAGENT_SETTINGS[*]} ${SAGENT_TUNABLES[*]}" >&2
                exit 1
            fi
            config_validate "$key" "$value"
            config_write "$key" "$value"
            echo "[$SCRIPT_NAME] $key=\"$value\" written to $SAGENT_CONFIG_FILE" >&2
            if [ "$(setting_source "$key")" = env ]; then
                echo "[$SCRIPT_NAME] Note: $key is also set in this environment, which takes precedence over the file." >&2
            fi
            ;;
        unset)
            key="${2:-}"
            if ! config_key_known "$key"; then echo "[$SCRIPT_NAME] ERROR: unknown setting: $key" >&2; exit 1; fi
            config_write "$key" ""
            echo "[$SCRIPT_NAME] $key removed from $SAGENT_CONFIG_FILE" >&2
            ;;
        *)
            echo "[$SCRIPT_NAME] Usage: $SCRIPT_NAME config [list | set KEY VALUE | unset KEY | get KEY | path]" >&2
            exit 1
            ;;
    esac
}

tools_command() {
    local sub="${1:-}" name group desc status current new item
    case "$sub" in
        "" | list)
            echo "Tools in the sandbox image (SAGENT_TOOLS=\"$SAGENT_TOOLS\", $(setting_source SAGENT_TOOLS)):"
            printf '  %-18s %-6s %-22s %s\n' NAME GROUP STATUS DESCRIPTION
            while IFS='|' read -r name group desc; do
                if tool_selected "$name"; then
                    status="included"
                elif [ "$group" = java ] && [ "$JAVA_VERSION" = none ]; then
                    status="excluded (Java=none)"
                else
                    status="excluded"
                fi
                printf '  %-18s %-6s %-22s %s\n' "$name" "$group" "$status" "$desc"
            done <<EOF
$SAGENT_TOOL_REGISTRY
EOF
            echo "Toolchain: ubuntu=$UBUNTU_VERSION node=$NODE_VERSION python=$PYTHON_VERSION go=$GO_VERSION rust=$RUST_VERSION java=$JAVA_VERSION"
            echo "Change with: $SCRIPT_NAME tools enable|disable NAME... (names or groups all, none, js, java); versions with: $SCRIPT_NAME config set SAGENT_<LANG>_VERSION <version>"
            ;;
        enable | disable)
            shift
            if [ $# -eq 0 ]; then echo "[$SCRIPT_NAME] Usage: $SCRIPT_NAME tools $sub NAME..." >&2; exit 1; fi
            # Start from the explicit resolved list, then add or remove.
            current=" $TOOLS_SELECTED "
            for item in "$@"; do
                case "$item" in
                    all | js | java | none) ;;
                    *)
                        if ! tool_known "$item"; then
                            echo "[$SCRIPT_NAME] ERROR: unknown tool: $item" >&2
                            echo "[$SCRIPT_NAME] Known: $(printf '%s\n' "$SAGENT_TOOL_REGISTRY" | cut -d'|' -f1 | tr '\n' ' ')and the groups all, none, js, java" >&2
                            exit 1
                        fi
                        ;;
                esac
            done
            new=""
            while IFS='|' read -r name group _; do
                case "$sub" in
                    enable)
                        if [ -z "${current##* "$name" *}" ]; then new="$new,$name"; continue; fi
                        for item in "$@"; do
                            case "$item" in all | "$group" | "$name") new="$new,$name"; break ;; esac
                        done
                        ;;
                    disable)
                        [ -n "${current##* "$name" *}" ] && continue
                        for item in "$@"; do
                            case "$item" in all | none | "$group" | "$name") continue 2 ;; esac
                        done
                        new="$new,$name"
                        ;;
                esac
            done <<EOF
$SAGENT_TOOL_REGISTRY
EOF
            new="${new#,}"
            [ -n "$new" ] || new="none"
            resolve_tools "$new"
            config_write SAGENT_TOOLS "$new"
            echo "[$SCRIPT_NAME] SAGENT_TOOLS=\"$new\" written to $SAGENT_CONFIG_FILE" >&2
            echo "[$SCRIPT_NAME] Included now: ${TOOLS_SELECTED:-none}. The image rebuilds with this selection on the next run." >&2
            if [ "$(setting_source SAGENT_TOOLS)" = env ]; then
                echo "[$SCRIPT_NAME] Note: SAGENT_TOOLS is also set in this environment, which takes precedence over the file." >&2
            fi
            ;;
        *)
            echo "[$SCRIPT_NAME] Usage: $SCRIPT_NAME tools [list | enable NAME... | disable NAME...]" >&2
            exit 1
            ;;
    esac
}

# ---- `status` and `doctor`: snapshot and diagnostics ----

wrapper_install_kind() {
    local script_path script_dir
    script_path="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]:-$0}")"
    script_dir="$(dirname "$script_path")"
    if git -C "$script_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'git checkout at %s' "$script_dir"
    else
        printf 'release install at %s' "$script_path"
    fi
}

host_has_claude_credentials() {
    if [ "$(uname -s)" = "Darwin" ]; then
        security find-generic-password -s "Claude Code-credentials" -w >/dev/null 2>&1
    else
        [ -f "${HOME}/.claude/.credentials.json" ] || [ -f "${XDG_CONFIG_HOME:-${HOME}/.config}/claude-code/credentials.json" ]
    fi
}

host_has_codex_auth() { [ -f "${CODEX_HOME:-${HOME}/.codex}/auth.json" ]; }

host_git_identity_line() {
    local id
    id=$(host_git_identity)
    if [ -n "$id" ]; then printf '%s' "$id"; else printf 'no identity in the host global config'; fi
}

clipboard_bridge_line() {
    local kind
    kind=$(host_clipboard_kind)
    if [ "${SAGENT_CLIPBOARD:-1}" = "0" ]; then
        printf 'bridge off (SAGENT_CLIPBOARD=0): copies go out as OSC 52, reads fail'
    elif [ -n "$kind" ]; then
        printf 'bridged both ways through the host (%s), text and images' "$kind"
    else
        printf 'no clipboard on this host (no DISPLAY or WAYLAND_DISPLAY): copies go out as OSC 52, reads fail'
    fi
}

git_protocol_line() {
    local proto
    proto=$(git_protocol)
    if [ "$proto" = ssh ]; then
        printf 'ssh from %s, ~/.ssh synced: %s key(s)' "$(git_protocol_source)" "$(host_ssh_key_count)"
    else
        printf 'https from %s, SSH remotes rewritten, gh token serves git' "$(git_protocol_source)"
    fi
}

host_gh_logins_line() {
    local line="" host user
    while read -r host user; do
        [ -n "$host" ] || continue
        line="$line${line:+, }$host${user:+ as $user}"
    done <<EOF
$(host_gh_logins)
EOF
    if [ -n "$line" ]; then printf '%s' "$line"; else printf 'not logged in on the host'; fi
}

# Read-only snapshot of what a run would use. Tolerates a missing engine.
status_command() {
    local latest cache_file engine_line image_line git_line vol_count vol_total=0 v size bytes
    local settings_from_file=0 settings_from_env=0 key

    printf '%-13s %s\n' "Wrapper:" "$SCRIPT_NAME v$WRAPPER_VERSION ($(wrapper_install_kind))"
    cache_file="${XDG_CACHE_HOME:-${HOME}/.cache}/sagent/release-check"
    latest=$(fetch_latest_release_tag 3)
    if [ -n "$latest" ]; then
        if [ "${latest#v}" = "$WRAPPER_VERSION" ]; then
            printf '%-13s %s\n' "Latest:" "$latest (up to date)"
        elif version_gt "${latest#v}" "$WRAPPER_VERSION"; then
            printf '%-13s %s\n' "Latest:" "$latest (newer; run: $SCRIPT_NAME update)"
        else
            printf '%-13s %s\n' "Latest:" "$latest (this wrapper is ahead of the latest release)"
        fi
    else
        printf '%-13s %s\n' "Latest:" "unknown (releases API unreachable$([ -f "$cache_file" ] && echo "; last check $(date -r "$(cat "$cache_file" 2>/dev/null || echo 0)" +%Y-%m-%dT%H:%M 2>/dev/null)"))"
    fi

    for key in "${SAGENT_SETTINGS[@]}"; do
        case "$(setting_source "$key")" in
            config) settings_from_file=$((settings_from_file + 1)) ;;
            env) settings_from_env=$((settings_from_env + 1)) ;;
        esac
    done
    if [ -f "$SAGENT_CONFIG_FILE" ]; then
        printf '%-13s %s\n' "Config:" "$SAGENT_CONFIG_FILE ($settings_from_file setting(s) from the file, $settings_from_env from the environment; \`$SCRIPT_NAME config\` lists them)"
    else
        printf '%-13s %s\n' "Config:" "$SAGENT_CONFIG_FILE (not created; $settings_from_env setting(s) from the environment)"
    fi

    if select_engine >/dev/null 2>&1; then
        detect_engine_flavor
        engine_line="$ENGINE_CMD (CLI: $ENGINE_CLI_FLAVOR, server: $ENGINE_SERVER_FLAVOR, rootless: $ENGINE_ROOTLESS"
        if [ "$ENGINE_CLI_FLAVOR" = docker ]; then
            engine_line="$engine_line, context: $("$ENGINE_CMD" context show 2>/dev/null || echo unknown)"
        fi
        printf '%-13s %s\n' "Engine:" "$engine_line)"
        if "$ENGINE_CMD" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
            image_line="$IMAGE_NAME built $("$ENGINE_CMD" image inspect "$IMAGE_NAME" --format '{{.Created}}' 2>/dev/null | cut -c1-16), $("$ENGINE_CMD" images "$IMAGE_REPO" --format '{{.Tag}} {{.Size}}' 2>/dev/null | awk -v t="$VERSION_HASH" '$1 == t {print $2}')"
        else
            image_line="$IMAGE_NAME not built (builds on the next run)"
        fi
        printf '%-13s %s\n' "Image:" "$image_line"
    else
        printf '%-13s %s\n' "Engine:" "none responding (run \`$SCRIPT_NAME doctor\`)"
        printf '%-13s %s\n' "Image:" "$IMAGE_NAME (engine unavailable)"
    fi
    printf '%-13s %s\n' "Toolchain:" "ubuntu=$UBUNTU_VERSION node=$NODE_VERSION python=$PYTHON_VERSION go=$GO_VERSION rust=$RUST_VERSION java=$JAVA_VERSION"
    printf '%-13s %s\n' "Tools:" "${TOOLS_SELECTED:-none} (SAGENT_TOOLS=\"$SAGENT_TOOLS\")"
    if [ -n "$CA_BUNDLE_PATH" ]; then
        printf '%-13s %s\n' "CA bundle:" "$CA_BUNDLE_PATH ($CA_BUNDLE_CERT_COUNT certificate(s))"
    else
        printf '%-13s %s\n' "CA bundle:" "none"
    fi
    if [ "${SAGENT_DOCKER:-1}" = "0" ]; then
        printf '%-13s %s\n' "Nested:" "off (SAGENT_DOCKER=0)"
    else
        printf '%-13s %s\n' "Nested:" "on (--no-docker or SAGENT_DOCKER=0 to disable)"
    fi
    printf '%-13s %s\n' "Limits:" "memory=$MEMORY_LIMIT cpus=$CPU_LIMIT pids=$PIDS_LIMIT (nested: $PIDS_LIMIT_NESTED)"
    printf '%-13s %s\n' "Credentials:" "Claude: $(host_has_claude_credentials && echo "found on host (synced each run)" || echo "none on host (log in inside the sandbox)"); Codex: $(host_has_codex_auth && echo "auth.json found" || echo "none"); GH_TOKEN: $([ -n "${GH_TOKEN:-}" ] && echo set || echo unset)"
    printf '%-13s %s\n' "Host state:" "git: $(host_git_identity_line); gh: $(host_gh_logins_line); protocol: $(git_protocol_line) (synced into the sandbox each run)"
    printf '%-13s %s\n' "Clipboard:" "$(clipboard_bridge_line)"

    if [ -n "$ENGINE_CMD" ]; then
        vol_count=0
        for v in sclaude-config scodex-config "$ROOTFS_VOLUME" "$NPM_VOLUME" "$PIP_VOLUME" "$SHARE_VOLUME" "$APT_CACHE_VOLUME" "$APT_LISTS_VOLUME" "$CONTAINERS_VOLUME"; do
            if "$ENGINE_CMD" volume inspect "$v" >/dev/null 2>&1; then vol_count=$((vol_count + 1)); fi
        done
        while read -r v size; do
            case "$size" in *[0-9]*B) bytes=$(size_to_bytes "$size"); vol_total=$((vol_total + bytes)) ;; esac
        done <<EOF
$("$ENGINE_CMD" system df -v 2>/dev/null | awk '/^VOLUME NAME/ {t = 1; next} t && NF == 0 {t = 0} t && ($1 ~ /^(sagent-|sclaude-|scodex-)/) {print $1, $NF}')
EOF
        printf '%-13s %s\n' "Volumes:" "$vol_count of 9 present, $(bytes_to_size "$vol_total") (\`$SCRIPT_NAME volumes\` for the breakdown)"
    fi

    if git -C "$PWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if [ -z "$(git -C "$PWD" status --porcelain 2>/dev/null)" ]; then
            git_line="git: clean"
        else
            git_line="git: $(git -C "$PWD" status --porcelain 2>/dev/null | wc -l | tr -d ' ') uncommitted change(s)"
        fi
    else
        git_line="not a git repository"
    fi
    if [ "$(pwd -P)" != "$PWD" ]; then
        printf '%-13s %s\n' "Workspace:" "$PWD ($git_line; mounted from $(pwd -P))"
    else
        printf '%-13s %s\n' "Workspace:" "$PWD ($git_line)"
    fi
}

DOCTOR_PASS=0; DOCTOR_WARN=0; DOCTOR_FAIL=0

# Run the fetch a build step runs (curl to cli.github.com) inside the plain
# base image, with $1 applied as an extra CA bundle the way the build applies
# it (/dev/null for none). Prints a status line (TLS-OK, TLS-FAIL, APT-FAILED,
# PROBE-FAILED) and, on TLS-FAIL, the issuer of the chain the network presents.
build_tls_probe() {
    local bundle_in="$1" out status issuer free
    # shellcheck disable=SC2016
    out=$("$ENGINE_CMD" run --rm -i "ubuntu:${UBUNTU_VERSION}" sh -c '
        cat > /tmp/bundle.pem
        export DEBIAN_FRONTEND=noninteractive
        df -Pk / | awk "NR==2 {print \"FREE:\" int(\$4/1048576)}"
        if ! (apt-get update && apt-get install -y curl ca-certificates) >/tmp/apt.log 2>&1; then
            echo APT-FAILED
            tail -5 /tmp/apt.log
            exit 0
        fi
        if [ -s /tmp/bundle.pem ]; then
            mkdir -p /usr/local/share/ca-certificates/sagent
            awk -v dir=/usr/local/share/ca-certificates/sagent \
                "/-----BEGIN CERTIFICATE-----/ { n++; f = sprintf(\"%s/sagent-%03d.crt\", dir, n) } f { print > f } /-----END CERTIFICATE-----/ { close(f); f = \"\" }" /tmp/bundle.pem
            update-ca-certificates >/dev/null 2>&1
        fi
        if curl -fsSI --max-time 20 https://cli.github.com/ >/dev/null 2>&1; then
            echo TLS-OK
        else
            echo TLS-FAIL
            curl -kvsI --max-time 20 https://cli.github.com/ 2>&1 | grep -i "^\* *issuer:" | head -1
        fi
    ' < "$bundle_in" 2>&1) || true
    status=$(printf '%s\n' "$out" | grep -E '^(TLS-OK|TLS-FAIL|APT-FAILED)$' | head -1)
    issuer=$(printf '%s\n' "$out" | sed -n 's/^\* *issuer: *//Ip' | head -1)
    free=$(printf '%s\n' "$out" | sed -n 's/^FREE://p' | head -1)
    # status, issuer, free GiB in the engine, then whatever detail the probe
    # captured (the apt error when it could not install its own tools).
    printf '%s\n%s\n%s\n' "${status:-PROBE-FAILED}" "${issuer:-unknown}" "${free:-}"
    { printf '%s\n' "$out" | grep -vE '^(TLS-OK|TLS-FAIL|APT-FAILED|FREE:)' | grep -v '^\* *issuer:' | sed '/^$/d'; } || true
}

# Every certificate the host itself trusts beyond the public roots: the macOS
# System and login keychains (where MDM and proxy CAs land), or the Linux
# system bundle (which contains the site CA when the host trusts it).
export_host_trust_store() {
    local kc
    if [ "$(uname -s)" = "Darwin" ]; then
        for kc in /Library/Keychains/System.keychain "$HOME/Library/Keychains/login.keychain-db"; do
            [ -r "$kc" ] && security find-certificate -a -p "$kc" 2>/dev/null
        done
    else
        for kc in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
            if [ -r "$kc" ]; then cat "$kc"; break; fi
        done
    fi
    return 0
}

# Before any build: detect TLS interception on this network and fix it from
# the host's own trust store, so install and update need nothing from the
# user (#77). Facts drive every branch: the probe's result and what the host
# trust store contains. Nothing degrades silently; the one retry (a mirror
# that dropped a connection) says so and still fails loudly the second time.
ensure_build_tls() {
    local result status issuer candidate count bundle_dir free
    echo "[$SCRIPT_NAME] Checking that build steps can fetch over HTTPS from this network..." >&2
    result=$(build_tls_probe "${CA_BUNDLE_PATH:-/dev/null}")
    status=$(printf '%s\n' "$result" | sed -n 1p); issuer=$(printf '%s\n' "$result" | sed -n 2p)
    free=$(printf '%s\n' "$result" | sed -n 3p)
    if [ -n "$free" ] && [ "$free" -lt "$DISK_FREE_GB_MIN" ]; then
        echo "[$SCRIPT_NAME] WARNING: the engine has only ${free} GiB free where it stores images; this build may run out of disk." >&2
        print_disk_guidance "$free"
    fi
    case "$status" in
        TLS-OK) return 0 ;;
        APT-FAILED)
            # A mirror that drops one connection is common on a loaded CI
            # runner and says nothing about this network; probe once more
            # before blaming it.
            echo "[$SCRIPT_NAME] The probe could not install its own tools; retrying once..." >&2
            sleep 5
            result=$(build_tls_probe "${CA_BUNDLE_PATH:-/dev/null}")
            status=$(printf '%s\n' "$result" | sed -n 1p); issuer=$(printf '%s\n' "$result" | sed -n 2p)
            case "$status" in
                TLS-OK) return 0 ;;
                TLS-FAIL) ;;
                *)
                    if [ -n "$free" ] && [ "$free" -lt "$DISK_FREE_GB_MIN" ]; then
                        echo "[$SCRIPT_NAME] ERROR: a build container cannot install packages: the engine is out of disk." >&2
                        print_disk_guidance "$free"
                    else
                        echo "[$SCRIPT_NAME] ERROR: a build container cannot reach Ubuntu's apt mirrors twice in a row, so containers on this engine have no network (or a proxy blocks them). The probe said:" >&2
                        printf '%s\n' "$result" | sed -n '4,$p' | sed "s/^/  /" >&2
                    fi
                    exit 1
                    ;;
            esac
            ;;
        PROBE-FAILED)
            echo "[$SCRIPT_NAME] ERROR: could not start the probe container from ubuntu:${UBUNTU_VERSION} (is the engine able to pull images?)." >&2
            exit 1
            ;;
    esac
    # TLS-FAIL. The wrapper-managed bundle file is refreshed from the host
    # trust store like a missing one (an older export may have covered only
    # the System keychain); a user-supplied path is the user's to fix.
    bundle_dir="$(dirname "$SAGENT_CONFIG_FILE")"
    if [ -n "$CA_BUNDLE_PATH" ] && [ "$CA_BUNDLE_PATH" != "$bundle_dir/ca-bundle.pem" ]; then
        echo "[$SCRIPT_NAME] ERROR: this network intercepts TLS (chain issuer: $issuer) and SAGENT_CA_BUNDLE=$CA_BUNDLE_PATH ($CA_BUNDLE_CERT_COUNT certificate(s)) does not contain that CA." >&2
        echo "[$SCRIPT_NAME] Obtain the CA for \"$issuer\" as PEM and put it in that bundle, or unset SAGENT_CA_BUNDLE to let $SCRIPT_NAME take it from the host trust store." >&2
        exit 1
    fi
    if [ -n "$CA_BUNDLE_PATH" ]; then
        echo "[$SCRIPT_NAME] This network intercepts TLS (chain issuer: $issuer) and the saved bundle $CA_BUNDLE_PATH does not contain that CA; refreshing it from the host trust store..." >&2
    else
        echo "[$SCRIPT_NAME] This network intercepts TLS (chain issuer: $issuer); looking for that CA in the host trust store..." >&2
    fi
    candidate=$(mktemp); TEMP_FILES+=("$candidate")
    export_host_trust_store > "$candidate"
    count=$(grep -c -- '-----BEGIN CERTIFICATE-----' "$candidate" || true)
    if [ "$count" -eq 0 ]; then
        echo "[$SCRIPT_NAME] ERROR: the host trust store exported no certificates, so the CA for \"$issuer\" cannot be taken from it." >&2
        echo "[$SCRIPT_NAME] Obtain that CA as PEM from whoever runs the proxy and set SAGENT_CA_BUNDLE to it (see README, \"Corporate networks\")." >&2
        exit 1
    fi
    result=$(build_tls_probe "$candidate")
    status=$(printf '%s\n' "$result" | sed -n 1p)
    if [ "$status" != "TLS-OK" ]; then
        echo "[$SCRIPT_NAME] ERROR: the host trust store ($count certificate(s)) does not contain a CA for \"$issuer\" either." >&2
        echo "[$SCRIPT_NAME] Obtain that CA as PEM from whoever runs the proxy and set SAGENT_CA_BUNDLE to it (see README, \"Corporate networks\")." >&2
        exit 1
    fi
    mkdir -p "$bundle_dir"
    cp "$candidate" "$bundle_dir/ca-bundle.pem"
    chmod 0644 "$bundle_dir/ca-bundle.pem"
    config_write SAGENT_CA_BUNDLE "$bundle_dir/ca-bundle.pem"
    CA_BUNDLE_PATH="$bundle_dir/ca-bundle.pem"
    CA_BUNDLE_CERT_COUNT="$count"
    VERSION_HASH=$(get_version_hash)
    IMAGE_NAME="${IMAGE_REPO}:${VERSION_HASH}"
    echo "[$SCRIPT_NAME] The host trust store has it: $count certificate(s) saved to $CA_BUNDLE_PATH and SAGENT_CA_BUNDLE written to $SAGENT_CONFIG_FILE; the image (now $VERSION_HASH) will trust this network." >&2
}

doctor_build_tls_check() {
    local result status issuer
    result=$(build_tls_probe "${CA_BUNDLE_PATH:-/dev/null}")
    status=$(printf '%s\n' "$result" | sed -n 1p); issuer=$(printf '%s\n' "$result" | sed -n 2p)
    case "$status" in
        TLS-OK)
            if [ -n "$CA_BUNDLE_PATH" ]; then
                doctor_report PASS build-tls "build steps reach https://cli.github.com with SAGENT_CA_BUNDLE applied ($CA_BUNDLE_CERT_COUNT certificate(s))"
            else
                doctor_report PASS build-tls "build steps reach https://cli.github.com; no TLS interception on this network"
            fi
            ;;
        TLS-FAIL)
            if [ -n "$CA_BUNDLE_PATH" ]; then
                doctor_report FAIL build-tls "SAGENT_CA_BUNDLE ($CA_BUNDLE_CERT_COUNT certificate(s)) does not contain the CA that signs this network's TLS (chain issuer: $issuer); unset it to let the next build take the CA from the host trust store, or add that CA to the bundle"
            else
                doctor_report WARN build-tls "this network intercepts TLS (chain issuer: $issuer); the next build takes that CA from the host trust store automatically and stops with a message if it is not there"
            fi
            ;;
        APT-FAILED)
            doctor_report FAIL build-tls "a build container cannot reach Ubuntu's apt mirrors (no network from containers on this engine)"
            ;;
        *)
            doctor_report FAIL build-tls "could not start the probe container from ubuntu:${UBUNTU_VERSION}"
            ;;
    esac
}
doctor_report() {
    local level="$1" check="$2" message="$3"
    case "$level" in
        PASS) DOCTOR_PASS=$((DOCTOR_PASS + 1)) ;;
        WARN) DOCTOR_WARN=$((DOCTOR_WARN + 1)) ;;
        FAIL) DOCTOR_FAIL=$((DOCTOR_FAIL + 1)) ;;
    esac
    printf '  %-4s  %-12s %s\n' "$level" "$check" "$message"
}

# Environment diagnostics with a fix for anything that is wrong. Exit 1 when
# any check fails. Only reads state; the one container it may start runs
# `true`/`curl` inside the already-built image.
doctor_command() {
    local msg latest out rc v stamp expected stale="" old_images key unknown="" free
    echo "[$SCRIPT_NAME] doctor"

    # wrapper
    latest=$(fetch_latest_release_tag 5)
    if [ -z "$latest" ]; then
        doctor_report WARN wrapper "v$WRAPPER_VERSION; could not reach the GitHub releases API to check for updates"
    elif version_gt "${latest#v}" "$WRAPPER_VERSION"; then
        doctor_report WARN wrapper "v$WRAPPER_VERSION installed, $latest available: run \`$SCRIPT_NAME update\`"
    else
        doctor_report PASS wrapper "v$WRAPPER_VERSION is current ($(wrapper_install_kind))"
    fi
    doctor_report PASS shell "bash ${BASH_VERSION:-unknown} runs this wrapper (3.2+ supported; zsh works too)"

    # config
    if [ -f "$SAGENT_CONFIG_FILE" ]; then
        while IFS= read -r key; do
            config_key_known "$key" || unknown="$unknown $key"
        done <<EOF
$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$SAGENT_CONFIG_FILE" | tr -d '=')
EOF
        if [ -n "$unknown" ]; then
            doctor_report WARN config "$SAGENT_CONFIG_FILE sets keys the wrapper does not use:$unknown"
        else
            doctor_report PASS config "$SAGENT_CONFIG_FILE parses; settings valid"
        fi
    else
        doctor_report PASS config "no config file ($SAGENT_CONFIG_FILE); defaults in effect"
    fi

    # engine (no subshell: select_engine sets ENGINE_CMD for the checks below)
    msg=$(mktemp); TEMP_FILES+=("$msg")
    if select_engine 2>"$msg"; then
        detect_engine_flavor
        doctor_report PASS engine "$ENGINE_CMD responding (CLI: $ENGINE_CLI_FLAVOR, server: $ENGINE_SERVER_FLAVOR, rootless: $ENGINE_ROOTLESS)"
    else
        doctor_report FAIL engine "$(sed "s/^\[$SCRIPT_NAME\] //" "$msg" | tr '\n' ' ')"
    fi

    # workspace (engine-dependent checks inside validate_workspace)
    if [ -n "$ENGINE_CMD" ]; then
        if msg=$( (validate_workspace) 2>&1 ); then
            doctor_report PASS workspace "$PWD can be mounted$([ "$(pwd -P)" != "$PWD" ] && echo " (from $(pwd -P))")"
        else
            doctor_report FAIL workspace "$(printf '%s' "$msg" | sed "s/^\[$SCRIPT_NAME\] ERROR: //; s/^\[$SCRIPT_NAME\] //" | tr '\n' ' ')"
        fi
    fi
    if git -C "$PWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if [ -n "$(git -C "$PWD" status --porcelain 2>/dev/null)" ]; then
            doctor_report WARN git "workspace has uncommitted changes; commit first so the agent's edits stay reviewable with git diff"
        else
            doctor_report PASS git "workspace is a clean git checkout"
        fi
    else
        doctor_report WARN git "workspace is not a git repository; there is no way to review or revert the agent's edits"
    fi

    # Build-time TLS: exactly what a RUN step sees, in the plain base image,
    # with the configured CA bundle applied the way the build applies it. Works
    # before the sandbox image exists and names the intercepting CA on failure.
    if [ -n "$ENGINE_CMD" ]; then
        doctor_build_tls_check
    fi

    # image and what runs inside it
    if [ -n "$ENGINE_CMD" ]; then
        if "$ENGINE_CMD" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
            doctor_report PASS image "$IMAGE_NAME built"
            for v in "$TOOL_BIN" gh; do
                if out=$("$ENGINE_CMD" run --rm "$IMAGE_NAME" "$v" --version 2>&1 | head -1); then
                    doctor_report PASS "cli:$v" "$out"
                else
                    doctor_report FAIL "cli:$v" "does not run inside the image: $out"
                fi
            done
            # TLS from inside the sandbox: the corporate-proxy failure mode.
            out=$("$ENGINE_CMD" run --rm "$IMAGE_NAME" curl -fsSI --max-time 15 https://registry.npmjs.org/ 2>&1 >/dev/null); rc=$?
            if [ "$rc" -eq 0 ]; then
                doctor_report PASS network "the sandbox reaches https://registry.npmjs.org with a trusted certificate"
            elif printf '%s' "$out" | grep -qE 'curl: \(60\)|certificate'; then
                doctor_report FAIL network "TLS verification fails inside the sandbox (a TLS-inspecting proxy?): export its CA and set SAGENT_CA_BUNDLE (README, \"Corporate networks\")"
            else
                doctor_report FAIL network "no HTTPS from inside the sandbox: $(printf '%s' "$out" | tail -1)"
            fi
            if [ "${SAGENT_DOCKER:-1}" != "0" ]; then
                if out=$("$ENGINE_CMD" run --rm --device /dev/fuse --device /dev/net/tun "$IMAGE_NAME" true 2>&1); then
                    doctor_report PASS nested "engine exposes /dev/fuse and /dev/net/tun for nested containers"
                else
                    doctor_report FAIL nested "engine cannot pass /dev/fuse or /dev/net/tun ($(printf '%s' "$out" | tail -1)); run with --no-docker or set SAGENT_DOCKER=0"
                fi
            fi
            # cache stamps that the next run would clear
            for v in "$PIP_VOLUME:python=$PYTHON_VERSION" "$NPM_VOLUME:node=$NODE_VERSION" "$APT_CACHE_VOLUME:ubuntu=$UBUNTU_VERSION" "$CONTAINERS_VOLUME:ubuntu=$UBUNTU_VERSION"; do
                expected="${v#*:}"; v="${v%%:*}"
                "$ENGINE_CMD" volume inspect "$v" >/dev/null 2>&1 || continue
                stamp=$("$ENGINE_CMD" run --rm -v "$v:/vol:ro" "$IMAGE_NAME" sh -c 'cat /vol/.sagent-stamp 2>/dev/null; ls -A /vol | grep -v "^.sagent-stamp$" | head -1 >/dev/null && echo NONEMPTY' 2>/dev/null)
                case "$stamp" in
                    *NONEMPTY*) [ "$(printf '%s\n' "$stamp" | head -1)" = "$expected" ] || stale="$stale $v" ;;
                esac
            done
            if [ -n "$stale" ]; then
                doctor_report WARN caches "filled for another toolchain and cleared on the next run:$stale"
            else
                doctor_report PASS caches "cache volumes match the toolchain"
            fi
        else
            doctor_report WARN image "$IMAGE_NAME not built yet; the first run builds it (about 20 minutes), or run \`$SCRIPT_NAME --build\` now"
        fi
        old_images=$("$ENGINE_CMD" images "$IMAGE_REPO" --format '{{.Tag}}' 2>/dev/null | grep -vcE "^($VERSION_HASH|latest)$" || true)
        if [ "${old_images:-0}" -gt 0 ]; then
            doctor_report WARN images "$old_images old sandbox image(s) on disk; \`$SCRIPT_NAME cleanup\` removes them"
        fi
    fi

    # credentials
    if host_has_claude_credentials; then
        doctor_report PASS auth:claude "Claude credentials found on the host (synced into the sandbox each run)"
    else
        doctor_report WARN auth:claude "no Claude credentials on the host; run \`claude\` once here, or log in inside the sandbox (persisted in sclaude-config)"
    fi
    if host_has_codex_auth; then
        doctor_report PASS auth:codex "Codex auth.json found on the host"
    else
        doctor_report WARN auth:codex "no Codex auth.json on the host; scodex users log in inside the sandbox (persisted in scodex-config)"
    fi
    if [ -n "$(host_gh_logins)" ]; then
        doctor_report PASS auth:gh "gh logged in on the host ($(host_gh_logins_line)); synced into the sandbox each run, git uses it for GitHub over HTTPS"
    elif [ -n "${GH_TOKEN:-}" ]; then
        doctor_report PASS auth:gh "GH_TOKEN set on the host; forwarded into the sandbox"
    else
        doctor_report WARN auth:gh "gh is not logged in on the host and GH_TOKEN is unset; run \`gh auth login\` here to sync it, or inside the sandbox (persisted in sagent-rootfs)"
    fi
    free=$(engine_disk_free_gb)
    if [ -z "$free" ]; then
        doctor_report WARN disk "could not read how much space the engine has for images"
    elif [ "$free" -lt "$DISK_FREE_GB_MIN" ]; then
        doctor_report FAIL disk "the engine has ${free} GiB free where it stores images; a build needs about $DISK_FREE_GB_MIN GiB. \`$SCRIPT_NAME cleanup\` and \`$ENGINE_CMD image prune -f\` reclaim it (a VM-backed engine needs a trim or a restart afterwards to hand the space back to the host)"
    else
        doctor_report PASS disk "${free} GiB free in the engine for images"
    fi
    if [ "${SAGENT_CLIPBOARD:-1}" = "0" ]; then
        doctor_report PASS clipboard "bridge off (SAGENT_CLIPBOARD=0): the sandbox copies through the terminal (OSC 52) and cannot read the host clipboard"
    elif [ -n "$(host_clipboard_kind)" ]; then
        doctor_report PASS clipboard "host clipboard bridged into the sandbox ($(host_clipboard_kind)); the agent inside can read and set it, SAGENT_CLIPBOARD=0 turns that off"
    else
        doctor_report WARN clipboard "no clipboard on this host (no DISPLAY or WAYLAND_DISPLAY, or no wl-copy/xclip): the sandbox copies through the terminal (OSC 52) and cannot paste from the host"
    fi
    if [ "$(git_protocol)" = ssh ]; then
        if [ "$(host_ssh_key_count)" -gt 0 ]; then
            doctor_report PASS git:protocol "ssh ($(git_protocol_source)): $(host_ssh_key_count) key pair(s) and the config from ~/.ssh are synced into the sandbox; a passphrase-protected key cannot be unlocked there"
        else
            doctor_report WARN git:protocol "ssh ($(git_protocol_source)) but ~/.ssh holds no key pair, so git cannot reach GitHub over SSH from the sandbox; add a key here or \`$SCRIPT_NAME config set SAGENT_GIT_PROTOCOL https\`"
        fi
    else
        doctor_report PASS git:protocol "https ($(git_protocol_source)): SSH remotes are rewritten to HTTPS and gh's token serves git; no SSH keys enter the sandbox"
    fi
    if [ -n "$(host_git_identity)" ]; then
        doctor_report PASS git:identity "commits in the sandbox are by $(host_git_identity) (the identity git uses in this directory, synced each run; signing settings are not carried over)"
    else
        doctor_report WARN git:identity "git has no user.name/user.email here, so commits in the sandbox would have none either; set them with \`git config --global\`"
    fi

    echo "Summary: $DOCTOR_PASS passed, $DOCTOR_WARN warning(s), $DOCTOR_FAIL failed"
    [ "$DOCTOR_FAIL" -eq 0 ]
}

print_release_guidance() {
    local latest_tag="$1"

    echo "[$SCRIPT_NAME] New wrapper release available: $latest_tag (installed: v$WRAPPER_VERSION)" >&2
    echo "[$SCRIPT_NAME] Update/install scripts:" >&2
    echo "  sudo curl -fsSL https://github.com/$PROJECT_REPO/releases/latest/download/sclaude -o /usr/local/bin/sclaude" >&2
    echo "  sudo chmod +x /usr/local/bin/sclaude" >&2
    echo "  sudo curl -fsSL https://github.com/$PROJECT_REPO/releases/latest/download/scodex -o /usr/local/bin/scodex" >&2
    echo "  sudo chmod +x /usr/local/bin/scodex" >&2
}

# Fetch the latest release tag (e.g. "v2.4.0") or print empty on failure.
# $1 optionally caps the curl time budget in seconds (default 5).
fetch_latest_release_tag() {
    local max_time="${1:-5}"
    if ! command -v curl >/dev/null 2>&1; then
        return 0
    fi
    curl -fsSL --max-time "$max_time" "https://api.github.com/repos/$PROJECT_REPO/releases/latest" 2>/dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1 || true
}

# Returns 0 iff $1 is strictly greater than $2 under version sort. Empty strings sort lowest.
version_gt() {
    [ -n "$1" ] || return 1
    [ "$1" = "$2" ] && return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]
}

# Download the named release asset for $tag into $dest. Verifies the asset is a bash script
# that self-identifies as $asset at $tag. Returns 0 on success.
download_release_asset() {
    local tag="$1"
    local asset="$2"
    local dest="$3"
    local url="https://github.com/$PROJECT_REPO/releases/download/$tag/$asset"
    local expected_version="${tag#v}"

    if ! curl -fsSL --max-time 30 "$url" -o "$dest"; then
        echo "[$SCRIPT_NAME] Failed to download $url" >&2
        return 1
    fi
    if ! head -1 "$dest" | grep -q '^#!/usr/bin/env bash$'; then
        echo "[$SCRIPT_NAME] Downloaded $asset has unexpected shebang; refusing to install" >&2
        return 1
    fi
    if ! grep -qE "^SCRIPT_NAME=\"$asset\"\$" "$dest"; then
        echo "[$SCRIPT_NAME] Downloaded $asset does not declare SCRIPT_NAME=\"$asset\"; refusing to install" >&2
        return 1
    fi
    # WRAPPER_VERSION mismatch is a warning, not a hard reject: release-please cannot
    # always be relied on to bump the constant in the published asset, and blocking
    # self-update on that release-time bug would defeat the point of self-update.
    if ! grep -qE "^WRAPPER_VERSION=\"$expected_version\"( *#.*)?\$" "$dest"; then
        echo "[$SCRIPT_NAME] WARNING: downloaded $asset does not declare WRAPPER_VERSION=\"$expected_version\" (release packaging out of sync); install proceeding" >&2
    fi
    chmod +x "$dest"
}

# Atomically install $src to $dest by staging into the destination directory and renaming
# over the existing file. Uses sudo if the directory is not writable. Returns 0 on success.
install_wrapper_file() {
    local src="$1"
    local dest="$2"
    local dest_dir staged

    dest_dir="$(dirname "$dest")"
    staged="$dest_dir/.$(basename "$dest").$$.$(date +%s).tmp"

    if [ -w "$dest_dir" ]; then
        if ! cp "$src" "$staged" \
            || ! chmod 0755 "$staged" \
            || ! mv -f "$staged" "$dest"; then
            rm -f "$staged" 2>/dev/null || true
            return 1
        fi
    elif command -v sudo >/dev/null 2>&1; then
        echo "[$SCRIPT_NAME] $dest_dir is not writable; installing with sudo..." >&2
        if ! sudo cp "$src" "$staged" \
            || ! sudo chmod 0755 "$staged" \
            || ! sudo mv -f "$staged" "$dest"; then
            sudo rm -f "$staged" 2>/dev/null || true
            return 1
        fi
    else
        echo "[$SCRIPT_NAME] Cannot write $dest_dir and sudo is unavailable; skipping" >&2
        return 1
    fi
}

# Self-update the running wrapper (and its paired wrapper if present) to the latest release.
# Downloads both assets first; only installs after both downloads succeed. Re-execs the new
# wrapper to complete the update. Returns non-zero if any download or install step failed.
self_update_wrapper() {
    local latest_tag script_path script_dir paired_name paired_path
    local tmp_self tmp_paired=""

    if [ "${SAGENT_SKIP_SELF_UPDATE:-}" = "1" ]; then
        return 0
    fi

    script_path="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]:-$0}")"
    script_dir="$(dirname "$script_path")"
    case "$SCRIPT_NAME" in
        sclaude) paired_name="scodex" ;;
        scodex)  paired_name="sclaude" ;;
        *)       paired_name="" ;;
    esac
    paired_path=""
    if [ -n "$paired_name" ] && [ -f "$script_dir/$paired_name" ]; then
        paired_path="$script_dir/$paired_name"
    fi

    # A wrapper that resolves into a git checkout is a source install (README
    # suggests symlinking from the repo into /usr/local/bin). Overwriting it with
    # a release asset would clobber the user's working tree, so skip the wrapper
    # download and let the image rebuild proceed.
    if git -C "$script_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "[$SCRIPT_NAME] Wrapper runs from a git checkout ($script_dir); skipping wrapper self-update." >&2
        echo "[$SCRIPT_NAME] Update the checkout with: git -C \"$script_dir\" pull" >&2
        return 0
    fi

    latest_tag=$(fetch_latest_release_tag)
    if [ -z "$latest_tag" ]; then
        echo "[$SCRIPT_NAME] Could not reach the releases API; skipping wrapper self-update" >&2
        return 0
    fi

    if ! version_gt "${latest_tag#v}" "$WRAPPER_VERSION"; then
        echo "[$SCRIPT_NAME] Wrapper at v$WRAPPER_VERSION is at or newer than $latest_tag; skipping self-update" >&2
        return 0
    fi

    echo "[$SCRIPT_NAME] Updating wrapper from v$WRAPPER_VERSION to $latest_tag..." >&2

    # Phase 1: download every asset to staging before touching the installed files.
    tmp_self=$(mktemp)
    TEMP_FILES+=("$tmp_self")
    if ! download_release_asset "$latest_tag" "$SCRIPT_NAME" "$tmp_self"; then
        print_release_guidance "$latest_tag"
        return 1
    fi
    if [ -n "$paired_path" ]; then
        tmp_paired=$(mktemp)
        TEMP_FILES+=("$tmp_paired")
        if ! download_release_asset "$latest_tag" "$paired_name" "$tmp_paired"; then
            print_release_guidance "$latest_tag"
            return 1
        fi
    fi

    # Phase 2: install. Each install is atomic per file via stage-then-rename. The two-file
    # install is best-effort all-or-nothing — if the second fails we report the partial state.
    if ! install_wrapper_file "$tmp_self" "$script_path"; then
        echo "[$SCRIPT_NAME] ERROR: failed to install new wrapper at $script_path" >&2
        print_release_guidance "$latest_tag"
        return 1
    fi
    if [ -n "$tmp_paired" ]; then
        if ! install_wrapper_file "$tmp_paired" "$paired_path"; then
            echo "[$SCRIPT_NAME] ERROR: $script_path is now $latest_tag but $paired_path failed to install" >&2
            echo "[$SCRIPT_NAME] Install $paired_name manually:" >&2
            echo "  sudo curl -fsSL https://github.com/$PROJECT_REPO/releases/download/$latest_tag/$paired_name -o $paired_path" >&2
            echo "  sudo chmod +x $paired_path" >&2
            return 1
        fi
        echo "[$SCRIPT_NAME] Paired wrapper at $paired_path is now $latest_tag" >&2
    fi
    echo "[$SCRIPT_NAME] Wrapper at $script_path is now $latest_tag" >&2

    # Phase 3: re-exec the freshly installed self so the image rebuild runs on current logic.
    # Preserve --force-rebuild across the exec so the user's intent survives the wrapper swap.
    echo "[$SCRIPT_NAME] Re-running update with the new wrapper..." >&2
    cleanup_temp
    if [ "${FORCE_REBUILD:-false}" = true ]; then
        SAGENT_SKIP_SELF_UPDATE=1 exec "$script_path" update --force-rebuild
    else
        SAGENT_SKIP_SELF_UPDATE=1 exec "$script_path" update
    fi
}

# Fetch the latest published "version" for the npm package $1 (e.g. "@openai/codex"). Uses
# python3 for robust JSON parsing when available, falling back to a precise grep that only
# matches the top-level "version" field in the npm registry's /latest document. Empty output
# on any failure.
fetch_npm_latest() {
    local pkg="$1"
    local resp
    resp=$(curl -fsSL --max-time 5 "https://registry.npmjs.org/$pkg/latest" 2>/dev/null) || return 0
    if [ -z "$resp" ]; then
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        # No JSON parser available — return empty so `needs_image_rebuild` defaults to
        # rebuild. A regex over a registry document can misattribute a nested "version"
        # key, so we prefer empty-and-rebuild over a wrong version.
        return 0
    fi
    printf '%s' "$resp" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    v = d.get("version", "")
    if isinstance(v, str):
        print(v)
except Exception:
    pass
' 2>/dev/null || true
    return 0
}

# Probe the inner $1 CLI's --version inside the current image with a bounded timeout.
# Output is the first semver-shaped token on the first line of the CLI's output (avoids
# capturing an update banner before the actual version). Empty on any failure.
probe_image_tool_version() {
    local tool="$1"
    local -a timeout_cmd=()
    if command -v timeout >/dev/null 2>&1; then
        timeout_cmd=(timeout 15)
    elif command -v gtimeout >/dev/null 2>&1; then
        timeout_cmd=(gtimeout 15)
    fi
    "${timeout_cmd[@]+"${timeout_cmd[@]}"}" "$ENGINE_CMD" run --rm "$IMAGE_NAME" "$tool" --version 2>/dev/null \
        | head -1 \
        | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?' \
        | head -1 || true
}

# Returns 0 if the current image is missing or its Claude/Codex CLIs lag behind the latest
# published npm versions. Returns 1 (no rebuild needed) when both match. Any error along the
# way (no curl, image probe fails, npm unreachable) defaults to "rebuild needed" so we never
# silently skip a real update.
needs_image_rebuild() {
    local image_claude image_codex npm_claude npm_codex

    if ! "$ENGINE_CMD" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        return 0
    fi
    if ! command -v curl >/dev/null 2>&1; then
        return 0
    fi

    image_claude=$(probe_image_tool_version claude)
    image_codex=$(probe_image_tool_version codex)

    npm_claude=$(fetch_npm_latest "@anthropic-ai/claude-code")
    npm_codex=$(fetch_npm_latest "@openai/codex")

    if [ -z "$image_claude" ] || [ -z "$image_codex" ] || [ -z "$npm_claude" ] || [ -z "$npm_codex" ]; then
        return 0
    fi

    # Only the CLIs are behind: rebuild that one layer from the cached image
    # instead of the whole thing (a full rebuild is `update --force-rebuild`).
    BUILD_EXTRA_ARGS=(--build-arg "AGENT_CLI_REFRESH=claude-$npm_claude+codex-$npm_codex")

    if [ "$image_claude" = "$npm_claude" ] && [ "$image_codex" = "$npm_codex" ]; then
        echo "[$SCRIPT_NAME] Image already at latest: Claude $image_claude, Codex $image_codex" >&2
        echo "[$SCRIPT_NAME] Run \`$SCRIPT_NAME update --force-rebuild\` to refresh OS packages and the base image." >&2
        return 1
    fi

    [ "$image_claude" != "$npm_claude" ] && echo "[$SCRIPT_NAME] Claude $image_claude -> $npm_claude" >&2
    [ "$image_codex" != "$npm_codex" ] && echo "[$SCRIPT_NAME] Codex $image_codex -> $npm_codex" >&2
    return 0
}

# Confirm a build succeeded by re-inspecting the image tag and verifying both inner
# CLIs run inside the rebuilt image. The image is shared between sclaude and scodex,
# so a broken Claude install in `scodex update` is just as bad as a broken Codex
# install in `sclaude update` — verify both regardless of which wrapper was invoked.
verify_image_built() {
    local claude_version codex_version gh_version
    if ! "$ENGINE_CMD" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        echo "[$SCRIPT_NAME] ERROR: build completed but $IMAGE_NAME was not tagged" >&2
        exit 1
    fi
    if ! gh_version=$("$ENGINE_CMD" run --rm "$IMAGE_NAME" gh --version 2>&1); then
        echo "[$SCRIPT_NAME] ERROR: 'gh --version' failed inside the rebuilt image:" >&2
        printf '%s\n' "$gh_version" | sed 's/^/  /' >&2
        exit 1
    fi
    if ! claude_version=$("$ENGINE_CMD" run --rm "$IMAGE_NAME" claude --version 2>&1); then
        echo "[$SCRIPT_NAME] ERROR: 'claude --version' failed inside the rebuilt image:" >&2
        printf '%s\n' "$claude_version" | sed 's/^/  /' >&2
        exit 1
    fi
    if ! codex_version=$("$ENGINE_CMD" run --rm "$IMAGE_NAME" codex --version 2>&1); then
        echo "[$SCRIPT_NAME] ERROR: 'codex --version' failed inside the rebuilt image:" >&2
        printf '%s\n' "$codex_version" | sed 's/^/  /' >&2
        exit 1
    fi
    echo "[$SCRIPT_NAME] Claude Code CLI is now: $claude_version" >&2
    echo "[$SCRIPT_NAME] Codex CLI is now:        $codex_version" >&2
    echo "[$SCRIPT_NAME] GitHub CLI is now:       $(printf '%s\n' "$gh_version" | head -1)" >&2
}

check_release() {
    local explicit="${1:-false}"
    local cache_dir
    local cache_file
    local now
    local last_check
    local latest_tag

    if [ "${SAGENT_SKIP_RELEASE_CHECK:-}" = "1" ]; then
        return 0
    fi
    if ! command -v curl >/dev/null 2>&1; then
        return 0
    fi

    cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/sagent"
    cache_file="$cache_dir/release-check"
    now=$(date +%s)
    last_check="0"
    if [ "$explicit" != "true" ] && [ -f "$cache_file" ]; then
        last_check=$(cat "$cache_file" 2>/dev/null || echo "0")
        # A corrupted cache file must not break the wrapper: non-numeric content
        # would make the arithmetic below fatal under set -u.
        case "$last_check" in
            '' | *[!0-9]*) last_check=0 ;;
        esac
        if [ $((now - last_check)) -lt "$RELEASE_CHECK_INTERVAL_SECONDS" ]; then
            return 0
        fi
    fi

    if mkdir -p "$cache_dir" 2>/dev/null; then
        printf '%s\n' "$now" > "$cache_file" 2>/dev/null || true
    fi

    # Keep the passive per-run check on a tight 2s budget so startup never stalls.
    latest_tag=$(fetch_latest_release_tag 2)
    if [ -z "$latest_tag" ]; then
        if [ "$explicit" = "true" ]; then
            echo "[$SCRIPT_NAME] Could not check latest release." >&2
        fi
        return 0
    fi

    if [ "${latest_tag#v}" != "$WRAPPER_VERSION" ]; then
        print_release_guidance "$latest_tag"
    elif [ "$explicit" = "true" ]; then
        echo "[$SCRIPT_NAME] Wrapper scripts are up to date ($latest_tag)." >&2
    fi
}

reset_volumes() {
    echo "[$SCRIPT_NAME] WARNING: This will delete all persisted sandbox data (credentials, packages, preferences, sessions)." >&2
    confirm_or_exit
    echo "[$SCRIPT_NAME] Removing Docker volumes..." >&2
    # Stale never-started or exited sandbox containers pin the volumes; remove
    # them first so the volume removal can succeed. Running containers are left
    # alone and keep their volumes pinned (reported by remove_volumes).
    remove_stale_sandbox_containers
    remove_volumes sclaude-config scodex-config "$ROOTFS_VOLUME" "$NPM_VOLUME" "$PIP_VOLUME" "$SHARE_VOLUME" "$APT_CACHE_VOLUME" "$APT_LISTS_VOLUME" "$CONTAINERS_VOLUME"
    echo "[$SCRIPT_NAME] Reset complete. Volumes will be recreated on next run." >&2
}

parse_args() {
    WRAPPER_COMMAND=""
    YOLO=true
    FORCE_REBUILD=false
    DOCKER_TOOLING=true
    if [ "${SAGENT_DOCKER:-}" = "0" ]; then
        DOCKER_TOOLING=false
    fi
    ARGS=()
    for arg in "$@"; do
        case "$arg" in
            --yolo)
                YOLO=true
                ;;
            --no-yolo)
                YOLO=false
                ;;
            --docker)
                DOCKER_TOOLING=true
                ;;
            --no-docker)
                DOCKER_TOOLING=false
                ;;
            --force-rebuild)
                FORCE_REBUILD=true
                ;;
            build|--build|update|check-update|cleanup|version|--version|--version-info|volumes|reset|reset-caches|tools|config|status|doctor|shell|dockerfile)
                if [ -z "$WRAPPER_COMMAND" ] && [ "${#ARGS[@]}" -eq 0 ]; then
                    WRAPPER_COMMAND="$arg"
                else
                    ARGS+=("$arg")
                fi
                ;;
            *)
                ARGS+=("$arg")
                ;;
        esac
    done

    # --force-rebuild is meaningful only for `update`. Catch misuse early so a user
    # running `scodex --force-rebuild "do a thing"` does not silently lose the flag.
    if [ "$FORCE_REBUILD" = true ] && [ "$WRAPPER_COMMAND" != "update" ]; then
        echo "[$SCRIPT_NAME] ERROR: --force-rebuild is only valid with the 'update' command" >&2
        exit 1
    fi
}

create_volumes() {
    local existing v
    existing=$("$ENGINE_CMD" volume ls --format '{{.Name}}' 2>/dev/null || true)
    for v in "$CONFIG_VOLUME" "$ROOTFS_VOLUME" "$NPM_VOLUME" "$PIP_VOLUME" "$SHARE_VOLUME" "$APT_CACHE_VOLUME" "$APT_LISTS_VOLUME" "$CONTAINERS_VOLUME"; do
        if ! printf '%s\n' "$existing" | grep -qFx "$v"; then
            "$ENGINE_CMD" volume create "$v" >/dev/null 2>&1 || true
        fi
    done
}

# ---- Host state carried into the sandbox: git config, gh login ----

# Keys of the host's global git config that must not reach the sandbox:
# credential helpers, signing keys, editors, pagers, diff/merge tools and
# daemons that exist on the host only, and settings that hold host paths.
# Prefix match on the key git prints (section and name lowercased); a
# trailing dot covers a whole section. Everything else (identity, aliases,
# pull/push/rebase preferences, colors, LFS filters) is carried over.
HOST_GIT_SKIP_KEYS="credential. gpg. commit.gpgsign tag.gpgsign user.signingkey core.editor core.pager core.sshcommand core.hookspath core.excludesfile core.attributesfile core.askpass core.fsmonitor sequence.editor merge.tool merge.guitool mergetool. diff.tool diff.guitool diff.external difftool. pager. interactive.difffilter http.sslcainfo http.sslcapath http.sslcert http.sslkey http.cookiefile maintenance. url. include. includeif. sendemail. gui. guitool."

host_git_key_skipped() {
    local key="$1" skip
    for skip in $HOST_GIT_SKIP_KEYS; do
        case "$key" in "$skip"*) return 0 ;; esac
    done
    return 1
}

# The identity git uses in the workspace, "Name <email>" or empty. Read in
# the workspace, not from the global config alone: a conditional include
# (the usual work/personal split) or a repo-local value is what git actually
# commits as, and a global read outside the repo never sees either.
host_git_identity() {
    local dir name email
    command -v git >/dev/null 2>&1 || return 0
    dir="${WORKSPACE_PATH:-$PWD}"
    name=$(git -C "$dir" config --get user.name 2>/dev/null || true)
    email=$(git -C "$dir" config --get user.email 2>/dev/null || true)
    if [ -n "$name" ] || [ -n "$email" ]; then
        printf '%s <%s>' "$name" "$email"
    fi
}

# Stage the host's global git config for the sandbox home as git's XDG-level
# file, minus the host-only keys above; git writes it so quoting and
# multi-valued keys survive. ~/.gitconfig in the sandbox is read after this
# file and holds sandbox-only settings. The host's global excludes file goes
# in as git's default ignore location.
stage_host_git_config() {
    local dir="$1" cfg entry key value excludes name email
    cfg="$dir/home/.config/git/config"
    mkdir -p "$dir/home/.config/git"
    {
        echo "# Synced from the host's global git config by $SCRIPT_NAME on every run; edits here are lost."
        echo "# Host-only settings (credential helpers, signing, editor, pager, diff/merge tools) are left out."
        echo "# Sandbox-only settings go in ~/.gitconfig, which git reads after this file."
    } > "$cfg"
    command -v git >/dev/null 2>&1 || return 0
    { git config --global --includes --list --null 2>/dev/null || true; } | while IFS= read -r -d '' entry; do
        case "$entry" in
            *$'\n'*) key="${entry%%$'\n'*}"; value="${entry#*$'\n'}" ;;
            *) key="$entry"; value="true" ;;
        esac
        [ -n "$key" ] || continue
        host_git_key_skipped "$key" && continue
        git config --file "$cfg" --add "$key" "$value" 2>/dev/null || true
    done
    # An identity that only a conditional include or the repo itself
    # provides is not in the lines above (include.* and includeIf.* are
    # host-only keys, and the sandbox has no such paths), but it is what git
    # commits as here, so carry it over. A repo-local value still wins
    # inside the sandbox: the workspace's .git/config is mounted with it.
    if ! git config --file "$cfg" --get user.name >/dev/null 2>&1; then
        name=$(git -C "${WORKSPACE_PATH:-$PWD}" config --get user.name 2>/dev/null || true)
        [ -n "$name" ] && git config --file "$cfg" user.name "$name"
    fi
    if ! git config --file "$cfg" --get user.email >/dev/null 2>&1; then
        email=$(git -C "${WORKSPACE_PATH:-$PWD}" config --get user.email 2>/dev/null || true)
        [ -n "$email" ] && git config --file "$cfg" user.email "$email"
    fi
    excludes=$(git config --global --includes --get core.excludesfile 2>/dev/null || true)
    case "$excludes" in "~"/*) excludes="$HOME/${excludes#*/}" ;; esac
    [ -n "$excludes" ] || excludes="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
    if [ -f "$excludes" ]; then
        cp "$excludes" "$dir/home/.config/git/ignore"
    fi
}

gh_hosts_file() { printf '%s' "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml"; }

# Token gh holds for a host (keyring or hosts.yml). Token environment
# variables are masked: GH_TOKEN is forwarded to the sandbox as is and is
# never written down.
host_gh_token() {
    env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN gh auth token --hostname "$1" 2>/dev/null
}

# Hosts the host's gh is logged in to, one "host user" per line (user may be
# empty for logins gh recorded without one).
host_gh_logins() {
    local hosts_file host user
    command -v gh >/dev/null 2>&1 || return 0
    hosts_file=$(gh_hosts_file)
    [ -f "$hosts_file" ] || return 0
    while IFS= read -r host; do
        [ -n "$host" ] || continue
        host_gh_token "$host" >/dev/null || continue
        user=$(awk -v h="$host:" '$0 == h {inb = 1; next} /^[^[:space:]]/ {inb = 0} inb && $1 == "user:" {print $2; exit}' "$hosts_file")
        printf '%s %s\n' "$host" "$user"
    done <<EOF
$(awk '/^[^[:space:]#][^:]*:[[:space:]]*$/ {sub(/:[[:space:]]*$/, ""); print}' "$hosts_file")
EOF
}

# The git protocol in effect: SAGENT_GIT_PROTOCOL, else what the host's gh is
# configured with for github.com, else gh's own default.
git_protocol() {
    local hosts_file proto=""
    if [ -n "${SAGENT_GIT_PROTOCOL:-}" ]; then
        printf '%s' "$SAGENT_GIT_PROTOCOL"
        return 0
    fi
    hosts_file=$(gh_hosts_file)
    if [ -f "$hosts_file" ]; then
        proto=$(awk '$0 == "github.com:" {inb = 1; next} /^[^[:space:]]/ {inb = 0} inb && $1 == "git_protocol:" {print $2; exit}' "$hosts_file")
    fi
    case "$proto" in ssh | https) printf '%s' "$proto" ;; *) printf 'https' ;; esac
}

git_protocol_source() {
    if [ -n "${SAGENT_GIT_PROTOCOL:-}" ]; then
        printf 'SAGENT_GIT_PROTOCOL'
    elif [ -f "$(gh_hosts_file)" ] && grep -q '^    git_protocol:' "$(gh_hosts_file)" 2>/dev/null; then
        printf "the host's gh"
    else
        printf "gh's default"
    fi
}

# Stage the host's gh logins for the sandbox home: a hosts.yml carrying the
# token for each host gh is logged in to, with the git protocol in effect.
# Every host gets git's gh credential helper (github.com has it in the image
# too); with https, SSH remotes for the host are rewritten to HTTPS so the
# token serves them.
stage_host_gh_auth() {
    local dir="$1" cfg host user token proto
    cfg="$dir/home/.config/git/config"
    proto=$(git_protocol)
    while read -r host user; do
        [ -n "$host" ] || continue
        token=$(host_gh_token "$host") || continue
        [ -n "$token" ] || continue
        mkdir -p "$dir/home/.config/gh"
        {
            printf '%s:\n' "$host"
            printf '    oauth_token: %s\n' "$token"
            if [ -n "$user" ]; then printf '    user: %s\n' "$user"; fi
            printf '    git_protocol: %s\n' "$proto"
        } >> "$dir/home/.config/gh/hosts.yml"
        command -v git >/dev/null 2>&1 || continue
        if [ "$host" != github.com ]; then
            git config --file "$cfg" "credential.https://$host.helper" '!gh auth git-credential'
        fi
        if [ "$proto" = https ]; then
            git config --file "$cfg" --add "url.https://$host/.insteadOf" "git@$host:"
            git config --file "$cfg" --add "url.https://$host/.insteadOf" "ssh://git@$host/"
        fi
    done <<EOF
$(host_gh_logins)
EOF
}

# The host's SSH client files, for the ssh protocol: keys, config,
# known_hosts and the rest of the regular files in ~/.ssh. config loses the
# macOS-only UseKeychain option (Linux ssh rejects it) and absolute home
# paths become ~ so IdentityFile lines resolve in the sandbox. A manifest of
# what was synced lets the next run remove exactly these files again.
host_ssh_dir() { printf '%s' "$HOME/.ssh"; }

host_ssh_key_count() {
    local n=0 f
    for f in "$(host_ssh_dir)"/*.pub; do
        [ -f "$f" ] && [ -f "${f%.pub}" ] && n=$((n + 1))
    done
    printf '%s' "$n"
}

stage_host_ssh() {
    local dir="$1" src f name
    src=$(host_ssh_dir)
    [ "$(git_protocol)" = ssh ] || return 0
    [ -d "$src" ] || return 0
    mkdir -p "$dir/home/.ssh"
    : > "$dir/home/.ssh/.sagent-synced"
    for f in "$src"/* "$src"/.[!.]*; do
        if [ ! -f "$f" ] || [ -L "$f" ]; then continue; fi
        name=$(basename "$f")
        case "$name" in .sagent-synced) continue ;; esac
        if [ "$name" = config ]; then
            sed -e '/^[[:space:]]*[Uu][Ss][Ee][Kk][Ee][Yy][Cc][Hh][Aa][Ii][Nn][[:space:]]/d' \
                -e "s#$HOME/#~/#g" "$f" > "$dir/home/.ssh/config"
        else
            cp "$f" "$dir/home/.ssh/$name"
        fi
        printf '%s\n' "$name" >> "$dir/home/.ssh/.sagent-synced"
    done
}

# Container-side step of the sync, run as root with the home volume at
# /vol-rootfs and the staged tree at /tmp/sync. The synced git files mirror
# the host on every run (a stale one is removed when the host no longer has
# it); ~/.gitconfig is created so a sandbox-side `git config --global`
# lands there and wins over the synced file. gh's hosts.yml is replaced
# only when the host has a login, so a login made inside the sandbox
# stays until there is one on the host.
home_state_sync_script() {
    cat <<'EOF'
            mkdir -p /vol-rootfs/.config/git
            rm -f /vol-rootfs/.config/git/config /vol-rootfs/.config/git/ignore
            for f in config ignore; do
                if [ -f "/tmp/sync/home/.config/git/$f" ]; then
                    cp "/tmp/sync/home/.config/git/$f" "/vol-rootfs/.config/git/$f"
                fi
            done
            [ -e /vol-rootfs/.gitconfig ] || : > /vol-rootfs/.gitconfig
            chmod 644 /vol-rootfs/.config/git/* /vol-rootfs/.gitconfig 2>/dev/null || true
            chown "$TARGET_UID:$TARGET_GID" /vol-rootfs/.config /vol-rootfs/.gitconfig
            chown -R "$TARGET_UID:$TARGET_GID" /vol-rootfs/.config/git
            if [ -f /tmp/sync/home/.config/gh/hosts.yml ]; then
                mkdir -p /vol-rootfs/.config/gh
                cp /tmp/sync/home/.config/gh/hosts.yml /vol-rootfs/.config/gh/hosts.yml
                chmod 700 /vol-rootfs/.config/gh
                chmod 600 /vol-rootfs/.config/gh/hosts.yml
                chown -R "$TARGET_UID:$TARGET_GID" /vol-rootfs/.config/gh
            fi
            # SSH files synced on an earlier run go first (the manifest names
            # them; keys made inside the sandbox are not in it), then the
            # current run's set, if the protocol is ssh.
            if [ -f /vol-rootfs/.ssh/.sagent-synced ]; then
                while IFS= read -r f; do
                    [ -n "$f" ] && rm -f "/vol-rootfs/.ssh/$f"
                done < /vol-rootfs/.ssh/.sagent-synced
                rm -f /vol-rootfs/.ssh/.sagent-synced
            fi
            if [ -d /tmp/sync/home/.ssh ]; then
                mkdir -p /vol-rootfs/.ssh
                cp /tmp/sync/home/.ssh/.sagent-synced /vol-rootfs/.ssh/.sagent-synced
                while IFS= read -r f; do
                    [ -n "$f" ] && cp "/tmp/sync/home/.ssh/$f" "/vol-rootfs/.ssh/$f" && chmod 600 "/vol-rootfs/.ssh/$f"
                done < /vol-rootfs/.ssh/.sagent-synced
                chmod 700 /vol-rootfs/.ssh
                chown -R "$TARGET_UID:$TARGET_GID" /vol-rootfs/.ssh
            fi
EOF
}

read_credentials() {
    local codex_home
    local auth_path

    CREDS=""
    codex_home="${CODEX_HOME:-${HOME}/.codex}"
    auth_path="${codex_home}/auth.json"
    if [ -f "$auth_path" ]; then
        CREDS=$(cat "$auth_path" 2>/dev/null || true)
    fi
}

# Codex config files next to auth.json on the host, into the config volume.
stage_codex_config_files() {
    local dir="$1" codex_home="${CODEX_HOME:-${HOME}/.codex}" name
    if [ ! -d "$codex_home" ] || [ -L "$codex_home" ]; then
        return 0
    fi
    for name in config.toml instructions.md AGENTS.md; do
        if [ -f "$codex_home/$name" ] && [ ! -L "$codex_home/$name" ]; then
            cp "$codex_home/$name" "$dir/config/$name"
        fi
    done
}

sync_state() {
    local stage
    read_credentials

    # Everything the sandbox takes from the host goes over stdin as one tar
    # of a staged tree (config/ for the tool's config volume, home/ for the
    # shared home volume): a host bind mount is denied on SELinux-enforcing
    # hosts (Fedora/RHEL + podman) and breaks on paths containing colons.
    stage=$(mktemp -d)
    TEMP_FILES+=("$stage")
    mkdir -p "$stage/config" "$stage/home"
    if [ -n "$CREDS" ]; then
        (umask 077; printf '%s' "$CREDS" > "$stage/config/auth.json")
    fi
    stage_codex_config_files "$stage"
    stage_host_git_config "$stage"
    stage_host_gh_auth "$stage"
    stage_host_ssh "$stage"

    # bsdtar on macOS would otherwise record the files' provenance xattrs as
    # pax headers (GNU tar in the sandbox warns) or as AppleDouble ._ files.
    local -a tar_args=()
    if [ "$(uname -s)" = "Darwin" ]; then
        tar_args=(--no-xattrs --no-mac-metadata)
    fi

    # shellcheck disable=SC2016
    tar "${tar_args[@]+"${tar_args[@]}"}" -C "$stage" -cf - . | "$ENGINE_CMD" run --rm -i --user root "${USERNS_ARGS[@]+"${USERNS_ARGS[@]}"}" \
        -v "$CONFIG_VOLUME":/vol-config \
        -v "$ROOTFS_VOLUME":/vol-rootfs \
        -v "$NPM_VOLUME":/vol-npm \
        -v "$PIP_VOLUME":/vol-pip \
        -v "$SHARE_VOLUME":/vol-share \
        -v "$APT_CACHE_VOLUME":/vol-apt-cache \
        -v "$APT_LISTS_VOLUME":/vol-apt-lists \
        -v "$CONTAINERS_VOLUME":/vol-containers \
        "$IMAGE_NAME" \
        bash -c '
            TARGET_UID='"$HOST_UID"'
            TARGET_GID='"$HOST_GID"'
            # Cache volumes carry a stamp of the toolchain they were filled
            # for. A changed stamp means the contents are for another
            # Python/Node/Ubuntu (pip site-packages are per minor version,
            # npm native addons per Node ABI, apt and podman state per
            # release): clear them so the upgrade needs nothing from the user.
            stamp_volume() {
                local dir="$1" expected="$2" what="$3" current
                current=$(cat "$dir/.sagent-stamp" 2>/dev/null || true)
                if [ "$current" != "$expected" ]; then
                    if [ -n "$(find "$dir" -mindepth 1 -maxdepth 1 ! -name .sagent-stamp | head -1)" ]; then
                        echo "['"$SCRIPT_NAME"'] $what changed (${current:-unstamped} -> $expected): clearing $(basename "$dir" | sed s/^vol-/sagent-/) as its contents were built for the old version" >&2
                        find "$dir" -mindepth 1 -maxdepth 1 ! -name .sagent-stamp -exec rm -rf {} +
                    fi
                    printf "%s\n" "$expected" > "$dir/.sagent-stamp"
                fi
            }
            # ~/.local/share used to sit inside the pip volume, which is
            # cleared whenever the image Python changes. Move what is there
            # into its own volume the first time that volume is mounted, so
            # `update` is all an existing install needs.
            if [ -d /vol-pip/share ] && [ -z "$(ls -A /vol-share 2>/dev/null)" ] && [ -n "$(ls -A /vol-pip/share 2>/dev/null)" ]; then
                echo "['"$SCRIPT_NAME"'] Moving ~/.local/share (uv tools and uv-managed Pythons) into the sagent-share volume, where a Python change no longer clears it" >&2
                if (cd /vol-pip/share && tar -cf - .) | (cd /vol-share && tar -xf -); then
                    rm -rf /vol-pip/share
                    chown -R "$TARGET_UID:$TARGET_GID" /vol-share
                else
                    echo "['"$SCRIPT_NAME"'] Warning: could not move ~/.local/share; it stays in the pip volume" >&2
                fi
            fi
            stamp_volume /vol-pip "python='"$PYTHON_VERSION"'" "Sandbox Python"
            stamp_volume /vol-npm "node='"$NODE_VERSION"'" "Sandbox Node.js"
            stamp_volume /vol-apt-cache "ubuntu='"$UBUNTU_VERSION"'" "Sandbox Ubuntu"
            stamp_volume /vol-apt-lists "ubuntu='"$UBUNTU_VERSION"'" "Sandbox Ubuntu"
            stamp_volume /vol-containers "ubuntu='"$UBUNTU_VERSION"'" "Sandbox Ubuntu"
            for d in /vol-config /vol-rootfs /vol-npm /vol-pip /vol-share /vol-containers; do
                if [ "$(stat -c %u "$d" 2>/dev/null)" != "$TARGET_UID" ]; then
                    chown -R "$TARGET_UID:$TARGET_GID" "$d"
                fi
            done
            mkdir -p /vol-apt-cache/archives/partial /vol-apt-lists/partial
            chown -R root:root /vol-apt-cache /vol-apt-lists
            chmod 755 /vol-apt-cache /vol-apt-cache/archives /vol-apt-lists
            # -m: do not restore mtimes. The staged files are copies remade
            # on every run, and a host clock a fraction of a second ahead of
            # the VM the engine runs in made GNU tar warn that every one of
            # them had a time stamp in the future.
            mkdir -p /tmp/sync && tar -xmf - -C /tmp/sync
            if [ -f /tmp/sync/config/auth.json ]; then
                if python3 -m json.tool /tmp/sync/config/auth.json >/dev/null 2>&1; then
                    cp /tmp/sync/config/auth.json /vol-config/auth.json
                    chown "$TARGET_UID:$TARGET_GID" /vol-config/auth.json
                    chmod 600 /vol-config/auth.json
                else
                    echo "['"$SCRIPT_NAME"'] Warning: auth.json found but appears malformed, skipping sync" >&2
                fi
            fi
            rm -f /vol-config/._*
            for name in config.toml instructions.md AGENTS.md; do
                if [ -f "/tmp/sync/config/$name" ]; then
                    cp "/tmp/sync/config/$name" "/vol-config/$name"
                    chown "$TARGET_UID:$TARGET_GID" "/vol-config/$name"
                    chmod 600 "/vol-config/$name"
                fi
            done
'"$(home_state_sync_script)"'
        ' || echo "[$SCRIPT_NAME] Warning: host state sync failed (non-fatal)" >&2
}

validate_workspace() {
    if [ "$ENGINE_ROOTLESS" = true ] && [ "$ENGINE_CLI_FLAVOR" = "docker" ]; then
        echo "[$SCRIPT_NAME] ERROR: $ENGINE_CMD talks to a rootless $ENGINE_SERVER_FLAVOR daemon, which maps the sandbox user to a subordinate UID: the workspace bind mount would be unreadable or read-only inside the sandbox." >&2
        if [ "$ENGINE_SERVER_FLAVOR" = "podman" ]; then
            echo "[$SCRIPT_NAME] Use the podman CLI directly (SAGENT_CONTAINER_ENGINE=podman): it maps your user in with --userns=keep-id. The docker CLI cannot request that mapping." >&2
        else
            echo "[$SCRIPT_NAME] Rootless Docker is not supported; use a rootful Docker daemon or rootless podman via the podman CLI." >&2
        fi
        exit 1
    fi

    # Logical path (what the user sees, and what the tool's per-directory
    # session state is keyed on) becomes the mount target; the physical path
    # (symlinks resolved) is the mount source. Engines that run in a VM only
    # resolve paths against their shared mounts: on macOS /tmp is a symlink to
    # /private/tmp, and podman machine shares /private but not /tmp, so a
    # workspace under /tmp (or any symlinked directory) mounted empty (#71).
    WORKSPACE_PATH="$(pwd)"
    WORKSPACE_HOST_PATH="$(pwd -P)"
    if [ "$WORKSPACE_PATH" = "/" ] || [ "$WORKSPACE_HOST_PATH" = "/" ]; then
        echo "[$SCRIPT_NAME] ERROR: refusing to run with / as the workspace: the bind mount would expose the entire host filesystem to the sandbox." >&2
        echo "[$SCRIPT_NAME] Run from a project directory instead." >&2
        exit 1
    fi
    if [[ "$WORKSPACE_PATH" == *:* ]] || [[ "$WORKSPACE_HOST_PATH" == *:* ]]; then
        echo "[$SCRIPT_NAME] ERROR: workspace path contains a colon, which conflicts with Docker volume syntax:" >&2
        echo "  $WORKSPACE_PATH (resolves to $WORKSPACE_HOST_PATH)" >&2
        echo "[$SCRIPT_NAME] Please run from a directory without colons in its path." >&2
        exit 1
    fi

    # VM-backed engines share only a few host directories with their VM; any
    # other host path bind-mounts as an empty directory. Rancher Desktop and
    # colima are identifiable by the docker context they install and document
    # their default shares (the home directory plus one /tmp subdirectory), so
    # refuse instead of handing the agent an empty workspace (#74). Extra
    # shares configured in the tool (Rancher Desktop's lima override.yaml,
    # colima's mounts) are not visible here; SAGENT_SKIP_SHARE_CHECK=1 skips
    # the check for those setups.
    local context="" tool="" extra_share="" home_host
    if [ "$ENGINE_CLI_FLAVOR" = "docker" ] && [ "${SAGENT_SKIP_SHARE_CHECK:-}" != "1" ]; then
        context="$("$ENGINE_CMD" context show 2>/dev/null || true)"
        case "$context" in
            rancher-desktop) tool="Rancher Desktop"; extra_share="/tmp/rancher-desktop" ;;
            colima | colima-*) tool="colima"; extra_share="/tmp/colima" ;;
        esac
    fi
    if [ -n "$tool" ]; then
        home_host="$(cd "$HOME" && pwd -P)"
        case "$WORKSPACE_HOST_PATH" in
            "$home_host" | "$home_host"/* | "$extra_share" | "$extra_share"/*) ;;
            *)
                echo "[$SCRIPT_NAME] ERROR: $tool shares only $home_host and $extra_share with its VM; the workspace would mount empty:" >&2
                echo "  $WORKSPACE_HOST_PATH" >&2
                echo "[$SCRIPT_NAME] Run from a directory under $home_host, or set SAGENT_SKIP_SHARE_CHECK=1 if you added this path to $tool's shared mounts." >&2
                exit 1
                ;;
        esac
    fi
}

build_docker_tty_flags() {
    DOCKER_TTY_FLAGS=()
    if [ -t 0 ]; then
        DOCKER_TTY_FLAGS+=("-it")
    else
        DOCKER_TTY_FLAGS+=("-i")
    fi
}

# `shell`: a bash shell in the sandbox. Attaches to the sandbox already
# running for this workspace when there is one (the agent's live environment,
# same container), otherwise starts a fresh sandbox with the same mounts and
# volumes. Extra arguments go to bash (e.g. -c 'cmd').
open_shell() {
    local running
    running=$("$ENGINE_CMD" ps --filter "label=sagent.workspace=$WORKSPACE_PATH" --filter status=running --format '{{.ID}}' 2>/dev/null | head -1)
    if [ -n "$running" ]; then
        echo "[$SCRIPT_NAME] Attaching a shell to the sandbox running for $WORKSPACE_PATH (container $running)." >&2
        exec "$ENGINE_CMD" exec "${DOCKER_TTY_FLAGS[@]}" -w "$WORKSPACE_PATH" "$running" bash "${ARGS[@]+"${ARGS[@]}"}"
    fi
    echo "[$SCRIPT_NAME] No sandbox is running for $WORKSPACE_PATH; starting a fresh one. apt installs last until this shell exits; npm, pip, cargo, go and home-directory changes persist." >&2
    TOOL_BIN=bash
    YOLO=false
}

# ---- Clipboard bridge: the host's clipboard for the sandbox ----

# What the host can do with its clipboard: pbcopy/pbpaste/osascript on
# macOS; wl-copy/wl-paste on a Wayland session, xclip on an X session, on
# Linux. Empty means no clipboard here (a headless Linux host): the sandbox
# then copies through the terminal (OSC 52) and cannot paste.
host_clipboard_kind() {
    if [ "$(uname -s)" = "Darwin" ]; then
        printf 'macos'
    elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
        printf 'wayland'
    elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
        printf 'x11'
    fi
}

host_clipboard_copy() {   # stdin -> host clipboard
    case "$(host_clipboard_kind)" in
        macos) pbcopy ;;
        wayland) wl-copy ;;
        x11) xclip -selection clipboard ;;
    esac
}

# host_clipboard_paste TARGET OUTFILE: text, targets (one MIME type per
# line: text/plain, image/png), or image/png. Non-zero when the clipboard
# holds nothing of that kind.
host_clipboard_paste() {
    local target="$1" out="$2" info
    case "$(host_clipboard_kind)" in
        macos)
            case "$target" in
                text) pbpaste > "$out" ;;
                targets)
                    info=$(osascript -e 'clipboard info' 2>/dev/null || true)
                    : > "$out"
                    case "$info" in *PNGf* | *TIFF*) echo image/png >> "$out" ;; esac
                    case "$info" in *string* | *utf8* | *ut16*) echo text/plain >> "$out" ;; esac
                    [ -s "$out" ]
                    ;;
                image/png)
                    osascript \
                        -e 'set f to open for access POSIX file "'"$out"'" with write permission' \
                        -e 'try' \
                        -e '    write (the clipboard as «class PNGf») to f' \
                        -e 'on error' \
                        -e '    close access f' \
                        -e '    error "no image"' \
                        -e 'end try' \
                        -e 'close access f' >/dev/null 2>&1
                    ;;
                *) return 1 ;;
            esac
            ;;
        wayland)
            case "$target" in
                text) wl-paste --no-newline > "$out" ;;
                targets) wl-paste -l > "$out" ;;
                image/png) wl-paste --type image/png > "$out" ;;
                *) return 1 ;;
            esac
            ;;
        x11)
            case "$target" in
                text) xclip -selection clipboard -o > "$out" ;;
                targets) xclip -selection clipboard -t TARGETS -o > "$out" ;;
                image/png) xclip -selection clipboard -t image/png -o > "$out" ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

# The clipboard agent: serves requests the sandbox's clipboard shims drop
# into the bridge directory (req-ID.copy holds text to copy; req-ID.paste
# names a target and is answered with res-ID.ok or res-ID.fail). Files land
# by rename, so a request is complete when it is visible. Runs until killed.
clipboard_bridge_serve() {
    local dir="$1" parent=$$ f id target
    # $$ is the wrapper's pid even in this background subshell: stop with it
    # if it goes away without running its exit trap (SIGKILL, terminal gone).
    while kill -0 "$parent" 2>/dev/null; do
        for f in "$dir"/req-*.copy; do
            [ -e "$f" ] || continue
            host_clipboard_copy < "$f" || true
            rm -f "$f"
        done
        for f in "$dir"/req-*.paste; do
            [ -e "$f" ] || continue
            id=${f##*/req-}; id=${id%.paste}
            target=$(cat "$f")
            if host_clipboard_paste "$target" "$dir/res-$id.tmp" 2>/dev/null; then
                mv -f "$dir/res-$id.tmp" "$dir/res-$id.ok"
            else
                rm -f "$dir/res-$id.tmp"
                : > "$dir/res-$id.fail"
            fi
            rm -f "$f"
        done
        sleep 0.1
    done
}

# Start the agent for this run and set the mount and environment the
# sandbox needs to use it. The bridge directory lives under the cache
# directory (in the home directory, which VM-backed engines share), 700, and
# is removed with the run. WAYLAND_DISPLAY names no compositor; it is what
# makes the Claude CLI use the wl-copy/wl-paste shims instead of relying on
# OSC 52 alone. SAGENT_CLIPBOARD=0 leaves all of this out.
CLIPBOARD_BRIDGE_PID=""
CLIPBOARD_BRIDGE_ARGS=()
start_clipboard_bridge() {
    local dir base stale pid
    if [ "${SAGENT_CLIPBOARD:-1}" = "0" ] || [ -z "$(host_clipboard_kind)" ]; then
        return 0
    fi
    base="${XDG_CACHE_HOME:-$HOME/.cache}/sagent"
    mkdir -p "$base"
    # A run that died without its exit trap leaves its directory; its agent
    # is gone (it watches the wrapper's pid), so sweep those by the pid file.
    for stale in "$base"/clipboard.*; do
        [ -d "$stale" ] || continue
        pid=$(cat "$stale/.agent-pid" 2>/dev/null || true)
        if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$stale"
        fi
    done
    # Physical path: VM-backed engines resolve mounts against their shares
    # (the home directory), and a symlinked cache directory would mount empty.
    dir=$(cd "$(mktemp -d "$base/clipboard.XXXXXX")" && pwd -P)
    chmod 700 "$dir"
    TEMP_FILES+=("$dir")
    clipboard_bridge_serve "$dir" &
    CLIPBOARD_BRIDGE_PID=$!
    printf '%s\n' "$CLIPBOARD_BRIDGE_PID" > "$dir/.agent-pid"
    CLIPBOARD_BRIDGE_ARGS=(-v "$dir:/run/sagent/clipboard:rw" -e WAYLAND_DISPLAY=sagent-clipboard)
}

stop_clipboard_bridge() {
    if [ -n "$CLIPBOARD_BRIDGE_PID" ]; then
        kill "$CLIPBOARD_BRIDGE_PID" 2>/dev/null || true
        wait "$CLIPBOARD_BRIDGE_PID" 2>/dev/null || true
        CLIPBOARD_BRIDGE_PID=""
    fi
}

# ---- End clipboard bridge ----

run_tool() {
    local tool_args=()
    local nested_args=()
    local tmpfs_args=(--tmpfs "/tmp:rw,nosuid,size=1g")
    local pids_limit="$PIDS_LIMIT"

    case "$WORKSPACE_PATH" in
        /tmp | /tmp/*)
            # A tmpfs at /tmp would shadow the workspace bind mount beneath it
            # (mount ordering is engine-dependent; podman mounts the tmpfs last,
            # leaving the workspace empty inside the sandbox).
            tmpfs_args=()
            ;;
    esac

    if [ "$YOLO" = true ]; then
        tool_args=("$YOLO_FLAG" "${ARGS[@]+"${ARGS[@]}"}")
    else
        tool_args=("${ARGS[@]+"${ARGS[@]}"}")
    fi

    # `codex login` waits for a browser callback on 127.0.0.1:1455 inside the
    # sandbox, which no browser can reach; device-code sign-in is what Codex
    # documents for containers, so use it unless another mode was asked for
    # (#78). Device-code sign-in must be enabled in ChatGPT's security
    # settings; Codex says so if it is not.
    if [ "$TOOL_BIN" = codex ] && [ "${ARGS[0]:-}" = login ]; then
        case " ${ARGS[*]} " in
            *" --device-auth "* | *" --with-api-key "* | *" --with-access-token "* | *" status "* | *" --help "* | *" -h "*) ;;
            *)
                tool_args+=("--device-auth")
                echo "[$SCRIPT_NAME] Using device-code sign-in: a browser cannot call back into the sandbox. Enable device-code login in ChatGPT's security settings if Codex refuses it." >&2
                ;;
        esac
    fi

    # --docker mode: nested rootless podman needs the fuse and tun devices and
    # an unfiltered syscall table (mount and user-namespace syscalls that the
    # default seccomp profile only allows with CAP_SYS_ADMIN). Capabilities stay
    # dropped and the host engine socket is never exposed; nested containers
    # live entirely inside the sandbox.
    if [ "$DOCKER_TOOLING" = true ]; then
        nested_args=(--device /dev/fuse --device /dev/net/tun --security-opt seccomp=unconfined --security-opt apparmor=unconfined)
        pids_limit="$PIDS_LIMIT_NESTED"
    fi

    start_clipboard_bridge

    # label=disable: on SELinux-enforcing hosts (Fedora/RHEL + podman) the
    # workspace bind mount is otherwise unreadable without relabeling host files.
    # The terminal identity variables (which emulator, its version, color
    # depth) are forwarded when set: the CLIs use them to pick the keyboard
    # protocol (Shift+Enter), emit clickable hyperlinks, and name the right
    # modifier for text selection while their mouse tracking is on (Option in
    # iTerm2). Docker passes a bare -e only when the variable exists on the
    # host. LANG is not forwarded: the image sets C.UTF-8, which it has.
    # Not exec'd: the clipboard agent runs alongside and stops with the run.
    local rc=0
    "$ENGINE_CMD" run "${DOCKER_TTY_FLAGS[@]}" --rm "${USERNS_ARGS[@]+"${USERNS_ARGS[@]}"}" \
        "${CLIPBOARD_BRIDGE_ARGS[@]+"${CLIPBOARD_BRIDGE_ARGS[@]}"}" \
        -v "$WORKSPACE_HOST_PATH:$WORKSPACE_PATH:rw" \
        -v "$CONFIG_VOLUME:$CONFIG_MOUNT:rw" \
        -v "$ROOTFS_VOLUME:/home/agent:rw" \
        -v "$NPM_VOLUME:/home/agent/.npm-global:rw" \
        -v "$PIP_VOLUME:/home/agent/.local:rw" \
        -v "$SHARE_VOLUME:/home/agent/.local/share:rw" \
        -v "$CONTAINERS_VOLUME:/home/agent/.local/share/containers:rw" \
        -v "$APT_CACHE_VOLUME:/var/cache/apt:rw" \
        -v "$APT_LISTS_VOLUME:/var/lib/apt/lists:rw" \
        -w "$WORKSPACE_PATH" \
        --label "sagent.workspace=$WORKSPACE_PATH" \
        --label "sagent.tool=$SCRIPT_NAME" \
        --memory="$MEMORY_LIMIT" \
        --cpus="$CPU_LIMIT" \
        --pids-limit="$pids_limit" \
        "${nested_args[@]+"${nested_args[@]}"}" \
        "${tmpfs_args[@]+"${tmpfs_args[@]}"}" \
        --security-opt label=disable \
        --cap-drop=ALL \
        --cap-add=CHOWN \
        --cap-add=DAC_OVERRIDE \
        --cap-add=FOWNER \
        --cap-add=FSETID \
        --cap-add=SETGID \
        --cap-add=SETUID \
        --cap-add=SYS_CHROOT \
        --cap-add=NET_BIND_SERVICE \
        --network bridge \
        --ulimit nofile=8192:8192 \
        -e "$CONFIG_ENV_NAME=$CONFIG_MOUNT" \
        -e OPENAI_API_KEY \
        -e CODEX_API_KEY \
        -e OPENAI_BASE_URL \
        -e OPENAI_ORGANIZATION \
        -e OPENAI_PROJECT \
        -e CODEX_ACCESS_TOKEN \
        -e GH_TOKEN \
        -e "TERM=${TERM:-xterm-256color}" \
        -e TERM_PROGRAM \
        -e TERM_PROGRAM_VERSION \
        -e LC_TERMINAL \
        -e LC_TERMINAL_VERSION \
        -e COLORTERM \
        -e COLORFGBG \
        -e ITERM_SESSION_ID \
        -e ITERM_PROFILE \
        -e KITTY_WINDOW_ID \
        -e GHOSTTY_RESOURCES_DIR \
        -e WT_SESSION \
        -e VTE_VERSION \
        -e KONSOLE_VERSION \
        -e TERMINAL_EMULATOR \
        -e ZED_TERM \
        "$IMAGE_NAME" \
        "$TOOL_BIN" "${tool_args[@]+"${tool_args[@]}"}" || rc=$?
    stop_clipboard_bridge
    return "$rc"
}

