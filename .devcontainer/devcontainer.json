// Dev container for working on sclaude itself.
// Includes Docker-in-Docker (needed by E2E tests) and linting tools.
{
  "name": "sclaude-dev",
  // Built from the Dockerfile beside this file so CI can name an apt mirror;
  // with SAGENT_APT_MIRROR unset it is the same base image as before.
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "APT_MIRROR": "${localEnv:SAGENT_APT_MIRROR}" }
  },
  "features": {
    // E2E tests build and run Docker containers
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "none"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "timonwong.shellcheck",
        "mads-hartmann.bash-ide-vscode"
      ]
    }
  },
  // shellcheck, zsh, and pre-commit are needed for CI-equivalent linting
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y shellcheck zsh pipx && pipx install pre-commit",
  "remoteUser": "vscode"
}
